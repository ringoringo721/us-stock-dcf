{
  "buildCommand": "node scripts/build_site.cjs",
  "outputDirectory": "public",
  "git": {
    "deploymentEnabled": {
      "ringoringo721-dcf-historical-chart-fix": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
