{
  "buildCommand": "node scripts/build_site.cjs",
  "outputDirectory": "public",
  "git": {
    "deploymentEnabled": {
      "ringoringo721-dcf-historical-chart-fix": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:file(market_data|us_expansion_data|hk_market_data|hkex_expansion_data|fcff_data|hk_fcff_data|fmp_model_data|us_universe_data|hkex_universe_data).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
