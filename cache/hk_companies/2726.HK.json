ull,"previousDate":null,"reason":"missingPeriod","basis":"annual"}}},"real_history":{"revenue":[null,null,null,null,null,null],"net_income":[null,null,null,null,null,null],"gross_profit":[null,null,null,null,null,null],"operating_income":[null,null,null,null,null,null],"cfo":[null,null,null,null,null,null],"capex":[null,null,null,null,null,null],"fcf":[null,null,null,null,null,null]},"peers":["2631.HK","2658.HK","9971.HK"],"fin_valuation":{"is_financial":false},"image":"https://images.financialmodelingprep.com/symbol/2726.HK.png","logo":"https://images.financialmodelingprep.com/symbol/2726.HK.png","website":"https://epiworld.com.cn","ceo":"Gan Feng","full_time_employees":529,"description":"Epiworld International Co., Ltd. engages in research and development, production, and sales of silicon carbide semiconductor epitaxial wafers in the People's Republic of China, Europe, North America, and Asia. The company offers commercial 3 -, 4 -, 6 - and 8-inch silicon carbide epitaxial wafers. It also provides detection and analysis services of silicon carbide wafers (substrate and epitaxial) surface defects and epitaxial stacking faults (PL). The company's products are used to generate SiC power devices, widely utilized in electric vehicles, solar power, transportation, power distribution, AI computing centers, and aerospace. The company was formerly known as Hantian Tiancheng Electronic Technology (Xiamen) Co., Ltd. Epiworld International Co., Ltd. was incorporated in 2011 and is based in Xiamen, China.","description_en":"Epiworld International Co., Ltd. engages in research and development, production, and sales of silicon carbide semiconductor epitaxial wafers in the People's Republic of China, Europe, North America, and Asia. The company offers commercial 3 -, 4 -, 6 - and 8-inch silicon carbide epitaxial wafers. It also provides detection and analysis services of silicon carbide wafers (substrate and epitaxial) surface defects and epitaxial stacking faults (PL). The company's products are used to generate SiC power devices, widely utilized in electric vehicles, solar power, transportation, power distribution, AI computing centers, and aerospace. The company was formerly known as Hantian Tiancheng Electronic Technology (Xiamen) Co., Ltd. Epiworld International Co., Ltd. was incorporated in 2011 and is based in Xiamen, China.","description_zh":"中晶國際有限公司在中華人民共和國、歐洲、北美洲及亞洲從事碳化矽半導體磊晶晶圓的研發、生產及銷售。該公司提供商用三吋、四吋、六吋及八吋碳化矽磊晶晶圓。它還提供碳化矽晶圓（基板及磊晶）表面缺陷及磊晶堆疊缺陷（PL）的檢測及分析服務。該公司的產品廣泛應用於電動汽車、太陽能、交通運輸、配電、人工智慧計算中心及航空航天領域的碳化矽功率器件。中晶國際有限公司前身為漢天田成電子科技（廈門）有限公司，於二零一一年註冊成立，總部位於中國廈門。","address":"No. 198-1, East 2nd Road","city":"Xiamen","state":"FU","zip":"361101","country":"CN","phone":null,"full_address":"No. 198-1, East 2nd Road, Xiamen, FU, 361101, CN","year_high":141,"year_low":75.75,"range_52w":"75.75-141","all_time_high":null,"all_time_low":null,"inst_ownership_pct":null,"insider_ownership_pct":null,"top_holders":[],"insider_trades":[],"stock_splits":[],"news":[],"historical_dcf_series":null,"real_5y_prices":[],"dataAvailability":{"currentPrice":null,"hkdRiskFreeRate":"usdTreasuryProxyNotObservedHkdYield","asReportedLeases":"sourceUnavailable","ownership":"Provider coverage has not been verified for HKEX","historicalDcf":"No point-in-time historical valuations are available"},"ratingSources":{"fScore":{"asOfDate":null,"period":null,"basis":null,"evaluatedTests":0,"passedTests":0,"reason":"missingComparableStatements","evidenceHash":"eb9e7e2a605ac3aab2c392719b1a0d5852301f493289b4e6e9bb7aa59c5688fe","checkedAt":"2026-10-20T03:57:27.182684+00:00","releaseDate":null,"relatedCallDate":null,"scoringCurrency":null,"updatedAt":"2026-10-20T03:57:27.182684+00:00","applicability":null},"moat":{"asOfDate":null,"period":null,"evidenceHash":"5f0eb1afeb6e0880e5d827b8168a87b4db7be4a8ad3caa40b227fab300f0d04d","currentEvidenceHash":"5f0eb1afeb6e0880e5d827b8168a87b4db7be4a8ad3caa40b227fab300f0d04d","updatedAt":"2026-10-20T15:12:11.902533+00:00","reason":null,"checkedAt":"202