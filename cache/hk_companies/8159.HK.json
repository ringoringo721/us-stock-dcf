],"gross_profit":[21.026,30.57,14.598,13.366,9.53,null],"operating_income":[-58.144,-49.698,-51.8712,-47.232,-65.218,null],"cfo":[-74.773,10.619,-24.944,null,-20.047,null],"capex":[-4.172,-1.753,-5.95,null,-2.99,null],"fcf":[-78.945,8.866,-30.894,null,-23.037,null]},"peers":["0248.HK","0471.HK","1213.HK","1912.HK","1933.HK","2022.HK","2028.HK","2358.HK","8043.HK","8286.HK"],"fin_valuation":{"is_financial":false},"image":"https://images.financialmodelingprep.com/symbol/8159.HK.png","logo":"https://images.financialmodelingprep.com/symbol/8159.HK.png","website":"https://www.glorymark.com.tw","ceo":"Li Feng Wang","full_time_employees":1417,"description":"China United Venture Investment Limited functions as an investment holding company primarily focused on the design, production, and worldwide distribution of electronic connectivity solutions. Its operations are structured around three main segments: serving Original Equipment Manufacturers (OEMs), supplying retail distributors, and providing comprehensive architectural services. The company offers a broad spectrum of products, including computer and mobile device peripherals such as USB hubs, card readers, diverse cable types (e.g., lightning, HDMI, DisplayPort), docking stations, dongles, and adapters. Beyond these, its portfolio extends to multi-media and communication electronics, automotive accessories, wire harnesses, and medical equipment. Consumer electronics offerings include AC/car chargers, Bluetooth headsets and speakers, alarm clock radios, car kits, and car ashtrays. For industrial clients, the company delivers specialized solutions for EV charging, general automotive, medical and healthcare, and industrial machinery sectors. Additionally, China United Venture Investment Limited engages in architectural design work, covering master planning, general design, and schematic design. Its connectivity products are sold to OEM partners and retail channels across a significant international presence, including China, Taiwan, Korea, Japan, the United States, and other global territories. Established in 1990 under the name Glory Mark Hi-Tech (Holdings) Limited, the company rebranded to China United Venture Investment Limited in May 2022 and is based in Central, Hong Kong.","description_en":"China United Venture Investment Limited functions as an investment holding company primarily focused on the design, production, and worldwide distribution of electronic connectivity solutions. Its operations are structured around three main segments: serving Original Equipment Manufacturers (OEMs), supplying retail distributors, and providing comprehensive architectural services. The company offers a broad spectrum of products, including computer and mobile device peripherals such as USB hubs, card readers, diverse cable types (e.g., lightning, HDMI, DisplayPort), docking stations, dongles, and adapters. Beyond these, its portfolio extends to multi-media and communication electronics, automotive accessories, wire harnesses, and medical equipment. Consumer electronics offerings include AC/car chargers, Bluetooth headsets and speakers, alarm clock radios, car kits, and car ashtrays. For industrial clients, the company delivers specialized solutions for EV charging, general automotive, medical and healthcare, and industrial machinery sectors. Additionally, China United Venture Investment Limited engages in architectural design work, covering master planning, general design, and schematic design. Its connectivity products are sold to OEM partners and retail channels across a significant international presence, including China, Taiwan, Korea, Japan, the United States, and other global territories. Established in 1990 under the name Glory Mark Hi-Tech (Holdings) Limited, the company rebranded to China United Venture Investment Limited in May 2022 and is based in Central, Hong Kong.","description_zh":null,"address":"Shanghai Industrial Investment Building","city":"Hong Kong","state":null,"zip":nul