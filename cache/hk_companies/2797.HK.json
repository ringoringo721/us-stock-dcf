od","basis":"annual"},"operatingCashFlow":{"value":null,"date":null,"previousDate":null,"reason":"missingPeriod","basis":"annual"},"freeCashFlow":{"value":null,"date":null,"previousDate":null,"reason":"missingPeriod","basis":"annual"}}},"real_history":{"revenue":[null,null,null,null,null,null],"net_income":[null,null,null,null,null,null],"gross_profit":[null,null,null,null,null,null],"operating_income":[null,null,null,null,null,null],"cfo":[null,null,null,null,null,null],"capex":[null,null,null,null,null,null],"fcf":[null,null,null,null,null,null]},"peers":["1262.HK","1583.HK","1767.HK","1927.HK"],"fin_valuation":{"is_financial":false},"image":"https://images.financialmodelingprep.com/symbol/2797.HK.png","logo":"https://images.financialmodelingprep.com/symbol/2797.HK.png","website":"http://www.qiyunshan.cc","ceo":"Zhi Gao Liu","full_time_employees":1411,"description":"Jiangxi Qiyunshan Food Co., Ltd. operates as a fruit snacks company that primarily sells hog plum and other food products in China. The company's flagship product is the hog plum paste available in nine flavors with three additional variations, being low-sugar, reduced sugar and additive-free. It also produces hog plum pellets in two flavors, hog plum soft candy, hog plum gel, hog plum, and other fruit and vegetable pastes including oranges, green plum, loquat and Chinese water chestnut. Additionally, the company engages in provided branding and marketing services to Qiyunshan Oil Tea in respect of its camellia oil products. Its customers primarily encompass offline distributors and customers of its self-operated online stores. Jiangxi Qiyunshan Food Co., Ltd. was founded in 1958 and is headquartered in Ganzhou, China. Jiangxi Qiyunshan Food Co., Ltd. is a subsidiary of Jiangxi Chongyi County Food Factory.","description_en":"Jiangxi Qiyunshan Food Co., Ltd. operates as a fruit snacks company that primarily sells hog plum and other food products in China. The company's flagship product is the hog plum paste available in nine flavors with three additional variations, being low-sugar, reduced sugar and additive-free. It also produces hog plum pellets in two flavors, hog plum soft candy, hog plum gel, hog plum, and other fruit and vegetable pastes including oranges, green plum, loquat and Chinese water chestnut. Additionally, the company engages in provided branding and marketing services to Qiyunshan Oil Tea in respect of its camellia oil products. Its customers primarily encompass offline distributors and customers of its self-operated online stores. Jiangxi Qiyunshan Food Co., Ltd. was founded in 1958 and is headquartered in Ganzhou, China. Jiangxi Qiyunshan Food Co., Ltd. is a subsidiary of Jiangxi Chongyi County Food Factory.","description_zh":"江西齊雲山食品有限公司作為一家水果零食公司運營，主要在中國銷售野酸棗及其他食品產品。該公司的旗艦產品是野酸棗糕，提供九種口味，另有三種變體，分別是低糖、減糖和無添加。它還生產兩種口味的野酸棗粒、野酸棗軟糖、野酸棗凝膠、野酸棗，以及其他水果和蔬菜醬，包括橙子、青梅、枇杷和荸薺。此外，該公司還為齊雲山油茶提供其山茶油產品的品牌和營銷服務。其客戶主要包括線下分銷商和其自營線上商店的客戶。江西齊雲山食品有限公司成立於一九五八年，總部設在中國贛州。江西齊雲山食品有限公司是江西崇義縣食品廠的子公司。","address":"Niujiao River","city":"Ganzhou","state":"JX","zip":"341300","country":"CN","phone":null,"full_address":"Niujiao River, Ganzhou, JX, 341300, CN","year_high":118.7,"year_low":12.5,"range_52w":"12.5-118.7","all_time_high":null,"all_time_low":null,"inst_ownership_pct":null,"insider_ownership_pct":null,"top_holders":[],"insider_trades":[],"stock_splits":[],"news":[],"historical_dcf_series":null,"real_5y_prices":[],"dataAvailability":{"currentPrice":null,"hkdRiskFreeRate":"usdTreasuryProxyNotObservedHkdYield","asReportedLeases":"sourceUnavailable","ownership":"Provider coverage has not been verified for HKEX","historicalDcf":"No point-in-time historical valuations are available"},"ratingSources":{"fScore":{"asOfDate":null,"period":null,"basis":null,"evaluatedTests":0,"passedTests":0,"reason":"missingComparableStatements","evidenceHash":"eb9e7e2a605ac3aab2c392719b1a0d5852301f493289b4e6e9bb7aa59c5688fe","checkedAt":"2026-10-20T04:04:40.205474+00:00","releaseDate":null,"relate