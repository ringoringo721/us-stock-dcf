sis":"annual"},"freeCashFlow":{"value":null,"date":null,"previousDate":null,"reason":"missingPeriod","basis":"annual"}}},"real_history":{"revenue":[null,null,null,null,null,null],"net_income":[null,null,null,null,null,null],"gross_profit":[null,null,null,null,null,null],"operating_income":[null,null,null,null,null,null],"cfo":[null,null,null,null,null,null],"capex":[null,null,null,null,null,null],"fcf":[null,null,null,null,null,null]},"peers":["2577.HK","2658.HK","2726.HK","9971.HK"],"fin_valuation":{"is_financial":false},"image":"https://images.financialmodelingprep.com/symbol/2631.HK.png","logo":"https://images.financialmodelingprep.com/symbol/2631.HK.png","website":"http://www.sicc.cc","ceo":"Yanmin Zong","full_time_employees":1303,"description":"SICC Co., Ltd., together with its subsidiaries, engages in the research, development, production, and sale of silicon carbide substrate materials in China and internationally. The company is involved in the industrialization of silicon carbide substrates for the renewable energy and AI sectors. It also offers conductive silicon carbide single crystal and semi-insulating substrate materials. In addition, the company engages in technical development, consultation, and promotion services; production of graphite and carbon products, and wide bandgap semiconductor substrate materials; research and development of special electronic materials and technologies; and investment activities. Its products are used in the microwave electronics and power electronics fields, as well as for new energy vehicles, AI data centers, photovoltaic systems, AI glasses, rail transportation, power grids, home appliances, and advanced communication base stations. The company exports its products. The company was formerly known as SICC Materials Co., Ltd. and changed its name to SICC Co., Ltd. in November 2020. SICC Co., Ltd. was founded in 2010 and is based in Jinan, China.","description_en":"SICC Co., Ltd., together with its subsidiaries, engages in the research, development, production, and sale of silicon carbide substrate materials in China and internationally. The company is involved in the industrialization of silicon carbide substrates for the renewable energy and AI sectors. It also offers conductive silicon carbide single crystal and semi-insulating substrate materials. In addition, the company engages in technical development, consultation, and promotion services; production of graphite and carbon products, and wide bandgap semiconductor substrate materials; research and development of special electronic materials and technologies; and investment activities. Its products are used in the microwave electronics and power electronics fields, as well as for new energy vehicles, AI data centers, photovoltaic systems, AI glasses, rail transportation, power grids, home appliances, and advanced communication base stations. The company exports its products. The company was formerly known as SICC Materials Co., Ltd. and changed its name to SICC Co., Ltd. in November 2020. SICC Co., Ltd. was founded in 2010 and is based in Jinan, China.","description_zh":"中電科碳化矽有限公司及其子公司在中國及國際市場從事碳化矽基板材料的研發、生產和銷售。該公司致力於可再生能源和人工智能領域碳化矽基板的產業化。它還提供導電碳化矽單晶和半絕緣基板材料。此外，該公司還從事技術開發、諮詢和推廣服務；石墨和碳產品以及寬禁帶半導體基板材料的生產；特殊電子材料和技術的研發；以及投資活動。其產品應用於微波電子和電力電子領域，以及新能源汽車、人工智能數據中心、光伏系統、人工智能眼鏡、軌道交通、電網、家用電器和先進通信基站。該公司出口其產品。該公司前身為中電科碳化矽材料有限公司，並於二零二零年十一月更名為中電科碳化矽有限公司。中電科碳化矽有限公司成立於二零一零年，總部位於中國濟南。","address":"No.99 Tianyue South Road","city":"Jinan","state":"SD","zip":"250118","country":"CN","phone":null,"full_address":"No.99 Tianyue South Road, Jinan, SD, 250118, CN","year_high":138.7,"year_low":43.22,"range_52w":"43.22-138.7","all_time_high":null,"all_time_low":null,"inst_ownership_pct":null,"insider_ownership_pct":null,"top_holders":[],"insider_trades":[],"stock_splits":[],"news":[],"historical_dcf_series":null,"real_5y_prices":[],"dataAvailability":{"currentPrice":null,"hkdRiskFreeRate":"usdTreasuryProxyNotObservedHkdYield","asReportedLeases":"sourceUna