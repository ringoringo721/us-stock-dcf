ring and supply chain solutions primarily in the PRC (People's Republic of China). The company was formerly known as Guangzhou Meet Xiaomian Catering Management Co., Ltd. and changed its name to Guangzhou Xiao Noodles Catering Management Co., Ltd. in September 2023. Guangzhou Xiao Noodles Catering Management Co., Ltd. was incorporated in 2014 and is headquartered in Guangzhou, China.","description_zh":"廣州遇見小麵餐飲管理有限公司及其附屬公司在中國大陸經營自營麵館和特許經營業務。該公司亦提供餐飲管理服務。公司以「遇見小麵」品牌營運。其主要服務於中國大陸的餐廳顧客、特許經營商以及需要餐飲和供應鏈解決方案的企業。該公司前身為廣州遇見小麵餐飲管理有限公司，並於二零二三年九月更名為廣州遇見小麵餐飲管理有限公司。廣州遇見小麵餐飲管理有限公司成立於二零一四年，總部位於中國廣州。","address":"Guangzhou Banghua Global Trade Center","city":"Guangzhou","state":"GD","zip":"510000","country":"CN","phone":"86 40 0762 8000","full_address":"Guangzhou Banghua Global Trade Center, Guangzhou, GD, 510000, CN","year_high":6.07,"year_low":3,"range_52w":"3-6.07","all_time_high":null,"all_time_low":null,"inst_ownership_pct":null,"insider_ownership_pct":null,"top_holders":[],"insider_trades":[],"stock_splits":[],"news":[],"historical_dcf_series":null,"real_5y_prices":[],"dataAvailability":{"currentPrice":null,"hkdRiskFreeRate":"usdTreasuryProxyNotObservedHkdYield","asReportedLeases":"sourceUnavailable","ownership":"Provider coverage has not been verified for HKEX","historicalDcf":"No point-in-time historical valuations are available"},"ratingSources":{"fScore":{"asOfDate":null,"period":null,"basis":null,"evaluatedTests":0,"passedTests":0,"reason":"missingComparableStatements","evidenceHash":"eb9e7e2a605ac3aab2c392719b1a0d5852301f493289b4e6e9bb7aa59c5688fe","checkedAt":"2026-11-07T10:16:13.654399+00:00","releaseDate":null,"relatedCallDate":null,"scoringCurrency":null,"updatedAt":"2026-11-07T10:16:13.654399+00:00","applicability":null},"moat":{"asOfDate":null,"period":null,"evidenceHash":"b76eabf32e3d6bc6b6742347b5e7397cbd26a0c4d087d052ed9cbfa3f70cbcaa","currentEvidenceHash":"b76eabf32e3d6bc6b6742347b5e7397cbd26a0c4d087d052ed9cbfa3f70cbcaa","updatedAt":"2026-10-20T14:38:37.562325+