天、通訊、消費電子、醫療保健、智能家居和辦公室、智能設備、氫能、儲能、軌道交通和光伏發電設備等多個先進產業。深圳凱中精密技術股份有限公司服務全球客戶群，包括博世、戴姆勒、大陸集團、豐田、電裝、采埃孚、日本電產、約翰遜、博澤、法雷奧、萬寶至和博格華納等知名原始設備製造商和主要供應商。","address":"No. 22, Baoying South Road","city":"Guangzhou","state":"GD","zip":"510730","country":"CN","phone":null,"full_address":"No. 22, Baoying South Road, Guangzhou, GD, 510730, CN","year_high":222,"year_low":52.55,"range_52w":"52.55-222","all_time_high":null,"all_time_low":null,"inst_ownership_pct":null,"insider_ownership_pct":null,"top_holders":[],"insider_trades":[],"stock_splits":[],"news":[],"historical_dcf_series":null,"real_5y_prices":[],"dataAvailability":{"currentPrice":null,"hkdRiskFreeRate":"usdTreasuryProxyNotObservedHkdYield","asReportedLeases":"sourceUnavailable","ownership":"Provider coverage has not been verified for HKEX","historicalDcf":"No point-in-time historical valuations are available"},"ratingSources":{"fScore":{"asOfDate":null,"period":null,"basis":null,"evaluatedTests":0,"passedTests":0,"reason":"missingComparableStatements","evidenceHash":"8d694dd2f94c646cf64275df0e4a23b929c1fcb8be431e2eb4010e7267037b15","checkedAt":"2026-11-06T10:40:28.075630+00:00","releaseDate":null,"relatedCallDate":null,"scoringCurrency":"CNY","updatedAt":"2026-11-06T10:40:28.075630+00:00","applicability":null},"moat":{"asOfDate":"2026-09-30","period":"2026Q4","evidenceHash":"c3c5eab7202b550d526b852aed9c181c001dea76bf7d645adb1d0aa99a0b6b30","currentEvidenceHash":"1599aedbe0bd20fd1e5a90ded9602e63676696521377792bcfd4e8a807c6fa27","updatedAt":"2026-10-20T01:38:44.802406+00:00","reason":"staleEvidence","checkedAt":"2026-11-06T10:40:28.075630+00:00","lastError":null,"statementDate":"2026-09-30","transcriptDate":null,"method":"AI qualitative assessment anchored to dated financial statements and available transcript; not a reported accounting measure","model":"gemini-2.5-flash","assessmentPolicy":"researched-business-judgment-v4","provider":"Vertex AI","businessResearchSourceCount":23},"zScore":{"asOfDate":"2025-12-31","period":"FY