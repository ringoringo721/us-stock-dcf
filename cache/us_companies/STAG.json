eta_5y":0.92,"kd":4.5,"tax":21,"growth_10y":[5.4,4.9,4.4,4,3.8,3.5,3.2,2.9,2.6,2.2],"g1":5.4,"g2":3.5,"g":2.25,"wacc":7.12,"ev":10502.4,"fmp_official_ev":10502.4,"enterpriseValueBasis":"USD market capitalization + USD debt - USD cash and short-term investments","dcf_model_ev":9463.4,"ev_to_ebitda":14.1,"debt_to_ebitda":4.64,"net_debt_to_ebitda":4.63,"f_score":5,"f_score_breakdown":[{"id":1,"category":"盈利能力","desc":"資產回報率 ROA > 0","passed":1,"detail":"當期 ROA = 3.6%"},{"id":2,"category":"盈利能力","desc":"營業現金流 CFO > 0","passed":1,"detail":"自由現金流 = $398M"},{"id":3,"category":"盈利能力","desc":"資產回報率持續擴張 (ΔROA > 0)","passed":0,"detail":"回報率穩步領先同業基準"},{"id":4,"category":"盈利能力","desc":"應計利潤品質高 (CFO > 淨利潤)","passed":1,"detail":"真實現金流充沛，無虛報帳面獲利"},{"id":5,"category":"槓桿與償債","desc":"財務槓桿未惡化 (ΔLeverage ≤ 0)","passed":1,"detail":"總負債資產比率 = 50.3%"},{"id":6,"category":"槓桿與償債","desc":"短期流動性安全 (ΔLiquidity > 0)","passed":0,"detail":"流動比率 = 1.04"},{"id":7,"category":"槓桿與償債","desc":"股本未遭稀釋 (ΔShares ≤ 0)","passed":1,"detail":"未大幅增發新股割韭菜"},{"id":8,"category":"營運效率","desc":"毛利率擴張 (ΔMargin > 0)","passed":0,"detail":"產品定價權增強，毛利結構健康"},{"id":9,"category":"營運效率","desc":"資產週轉率提升 (ΔTurnover > 0)","passed":0,"detail":"每單位資產產出效益改善"}],"fair_val":31.21,"default_fair_val":31.21,"premium_pct":17.3,"is_undervalued":false,"pe_trailing":26.2,"pe_forward":23.1,"pb_trailing":1.9,"pb_forward":1.7,"div_yield":3.5,"ps_ratio":4.4,"fcf_to_ev":3.79,"fcf_to_mcap":5.64,"liab_to_assets":50.3,"cash_to_assets":0.2,"current_ratio":1.04,"roe":7.4,"roa":3.6,"moat":{"ticker":"STAG","period":"2026Q3","m1_brand_pricing":{"score":2,"comment_zh":"STAG Industrial 的業務模式主要聚焦於工業地產的租賃，其品牌價值和定價權相對有限。作為一個 REIT，其核心競爭力在於資產組合的質量和地理位置，而非消費者品牌忠誠度或獨特的產品定價能力。與消費品公司不同，工業地產的租金定價更多受到市場供需、租賃合約條款以及宏觀經濟環境的影響，而非品牌溢價。因此，在品牌定價權方面，STAG 的護城河較為薄弱，難以形成顯著的定價優勢，分數較低是合理的。","comment_en":"STAG Industrial's business model primarily focuses on leasing industrial properties, with relatively limited brand value and pricing power. As a REIT, its core competitiveness lies in the quality of its asset portfolio and geographical location, rather than consumer brand loyalty or unique product pricing capabilities. Unlike consumer goods companies, industrial property rent pricing is more influenced by market supply and demand, lease terms, and the macroeconomic environment, rather than brand premiums. Therefore, STAG's moat in terms of brand pricing power is relatively weak, making it difficult to form a significant pricing advantage. A low score is reasonable."},"m2_patents_regulatory":{"score":1,"comment_zh":"STAG Industrial 作為一家工業地產投資信託基金（REIT），其業務模式不依賴於專利或特許經營權。地產行業的進入壁壘主要體現在資本、土地獲取和開發能力上，而非技術專利或監管許可。雖然 REIT 的運營受到證券監管的約束，但這並非 STAG 獨有的競爭優勢，而是行業的普遍規則。因此，在專利和監管壁壘方面，STAG 幾乎沒有護城河可言，分數極低。","comment_en":"As an Industrial Real Estate Investment Trust (REIT), STAG Industrial's business model does not rely on patents or exclusive operating licenses. The barriers to entry in the real estate industry are mainly reflected in capital, land acquisition, and development capabilities, rather than technological patents or regulatory permits. Although REIT operations are subject to securities regulations, this is not a unique competitive advantage for STAG but rather a general industry rule. Therefore, STAG has virtually no moat in terms of patents and regulatory barriers, resulting in a very low score."},"m3_high_switching_costs":{"score":6,"comment_zh":"STAG Industrial 的租戶轉換成本相對較高，這主要源於工業地產的特殊性。租戶在尋找、搬遷和適應新的生產或倉儲設施時，會產生顯著的時間、金錢和運營中斷成本。特別是對於那些擁有高度定制化生產線或特定倉儲需求的租戶而言，更換地點的難度更大。儘管如此，租賃合約的長度、租戶自身的業務彈性和市場上可替代的物業供應量，都會影響轉換成本的絕對水平。因此，STAG 在此方面具有一定的護城河，但並非無懈可擊。","comment_en":"The tenant switching costs for STAG Industrial are relatively high, primarily due to the nature of industrial properties. Tenants incur significant costs in terms of time, money, and operational disruption when searching for, relocating to, and adapting to new production or warehousing facilities. This is especially true for tenants with highly customized production lines or specific warehousing needs, making relocation more difficult. Nevertheless, the length of lease agreements, the tenant's own business flexibility, and the availability of alternative properties in the market all affect the absolute level of switching costs. Therefore, STAG has a certain moat in this regard, but it is not impregnable."},"m4_network_effects":{"score":1,"comment_zh":"STAG Industrial 的業務模式，即工業地產租賃，基本上不具備網絡效應。網絡效應通常出現在平台型業務、社交媒體或通信服務中，即用戶越多，服務價值越大。在工業地產領域，單一物業的價值主要取決於其物理屬性、地理位置和租賃條件，而非租戶數量的增加。STAG 雖然擁有龐大的資產組合，但各個物業之間以及租戶之間，並不存在顯著的協同效應或網絡效應，無法形成自我強化的增長循環。因此，在此維度上，STAG 的護城河幾乎為零。","comment_en":"STAG Industrial's business model, which is industrial property leasing, essentially lacks network effects. Network effects typically appear in platform-based businesses, social media, or communication services, where the value of the service increases with the number of users. In the industrial real estate sector, the value of a single property primarily depends on its physical attributes, location, and lease terms, not on an increase in the number of tenants. Although STAG possesses a large portfolio of assets, there are no significant synergistic effects or network effects between individual properties or among tenants, preventing the formation of a self-reinforcing growth cycle. Therefore, STAG's moat in this dimension is almost non-existent."},"m5_cost_advantage_scale":{"score":7,"comment_zh":"STAG Industrial 作為一家大型工業地產 REIT，其規模帶來了一定的成本優勢。龐大的資產組合使其在採購、融資、物業管理和營銷方面能夠獲得更優惠的條款。例如，較低的融資成本、與供應商談判的議價能力，以及更高效的物業管理運營，都能夠降低單位資產的運營成本。這種規模經濟效應有助於提升盈利能力和競爭力。然而，工業地產的資本密集性意味著規模優勢並非絕對，競爭對手同樣可以通過擴張來獲取規模，因此其護城河屬於較為堅固的類型，但非頂級。","comment_en":"As a large industrial property REIT, STAG Industrial's scale provides certain cost advantages. Its extensive asset portfolio allows it to obtain more favorable terms in procurement, financing, property management, and marketing. For instance, lower financing costs, bargaining power with suppliers, and more efficient property management operations can reduce the operating costs per unit asset. This economy of scale helps enhance profitability and competitiveness. However, the capital-intensive nature of industrial real estate means that scale advantages are not absolute, and competitors can also achieve scale through expansion. Therefore, its moat in this dimension is relatively strong but not top-tier."},"m6_unique_geography_assets":{"score":8,"comment_zh":"STAG Industrial 的核心競爭力之一在於其多元化且策略性佈局的工業地產組合。公司專注於美國各地的二線及三線市場，這些市場的租賃需求穩定，且競爭相對較少。其資產組合涵蓋了廣泛的工業物業類型，包括現代倉儲、輕工業和傳統工業設施，能夠滿足不同租戶的多樣化需求。這種地理位置和物業類型的組合，使得 STAG 在特定區域和細分市場中建立了獨特的競爭優勢，難以被輕易複製。這構成了其較為堅固的護城河。","comment_en":"One of STAG Industrial's core competitive strengths lies in its diversified and strategically located portfolio of industrial properties. The company focuses on secondary and tertiary markets across the United States, where leasing demand is stable and competition is relatively less intense. Its portfolio encompasses a wide range of industrial property types, including modern warehousing, light industrial, and traditional industrial facilities, catering to the diverse needs of various tenants. This combination of geographical locations and property types allows STAG to establish a unique competitive advantage in specific regions and market segments that is difficult to replicate easily. This constitutes a relatively strong moat for the company."},"m7_operational_efficiency":{"score":7,"comment_zh":"STAG Industrial 在運營效率方面表現穩健。作為一家 REIT，其核心業務是高效地管理和租賃其龐大的房地產資產組合。公司通過精細化的物業管理、優化的租賃策略以及對成本的嚴格控制，努力提升資產的回報率和運營效率。其較高的 F-Score（5/9）和穩定的 FCF TTM（$398.1M）也側面印證了其良好的運營能力。儘管 REIT 行業普遍存在運營效率的競爭，但 STAG 持續的優化努力使其在此方面具備一定的護城河，能夠在市場中保持競爭力。","comment_en":"STAG Industrial demonstrates solid operational efficiency. As a REIT, its core business is the efficient management and leasing of its extensive real estate asset portfolio. The company strives to enhance asset returns and operational efficiency through meticulous property management, optimized leasing strategies, and strict cost controls. Its relatively high F-Score (5/9) and stable FCF TTM ($398.1M) indirectly confirm its good operational capabilities. Although operational efficiency is a common competitive factor in the REIT industry, STAG's continuous optimization efforts provide it with a certain moat in this area, enabling it to remain competitive in the market."},"m8_capital_allocation":{"score":6,"comment_zh":"STAG Industrial 的資本配置能力是其 REIT 業務模式的關鍵。公司需要有效地利用債務和股權融資來收購、開發和管理房地產資產，同時通過租金收入和資產出售來產生回報。其 ROE（7.4%）和 ROA（3.6%）顯示了其資產利用效率尚可，但並非頂尖水平。公司在維持股息支付的同時，也需要平衡再投資和債務償還。相較於那些擁有卓越併購記錄或能持續創造超額回報的企業，STAG 的資本配置能力屬於中等水平，其護城河相對穩固，但仍有提升空間。","comment_en":"STAG Industrial's capital allocation capability is crucial to its REIT business model. The company needs to effectively utilize debt and equity financing to acquire, develop, and manage real estate assets, while generating returns through rental income and asset sales. Its ROE (7.4%) and ROA (3.6%) indicate a reasonable level of asset utilization efficiency, though not top-tier. While maintaining dividend payments, the company must also balance reinvestment and debt repayment. Compared to companies with exceptional M&A track records or the ability to consistently generate excess returns, STAG's capital allocation capability is at a moderate level, providing a relatively stable moat, but with room for improvement."},"m9_customer_retention":{"score":6,"comment_zh":"STAG Industrial 在客戶保留方面具有一定的優勢，這主要歸因於工業地產租賃的長期合約性質以及租戶的轉換成本。一旦租戶與 STAG 簽訂了長期租賃協議，並且其業務運營高度依賴於該物業，那麼在合約到期後，租戶傾向於續約，以避免搬遷的麻煩和費用。STAG 通過提供穩定、可靠的物業服務和具有競爭力的租賃條款來維持客戶關係。然而，市場上的租賃選擇、租戶自身的擴張或收縮需求，以及租金水平的波動，都可能影響客戶的最終續約決策。因此，其客戶保留能力屬於中等偏上水平。","comment_en":"STAG Industrial possesses a certain advantage in customer retention, primarily attributed to the long-term nature of industrial property leases and the switching costs for tenants. Once a tenant signs a long-term lease agreement with STAG and their business operations are highly dependent on the property, they tend to renew the lease upon expiration to avoid the hassle and expense of relocation. STAG maintains customer relationships by providing stable, reliable property services and competitive leasing terms. However, available leasing options in the market, the tenant's own expansion or contraction needs, and fluctuations in rental rates can influence the tenant's final renewal decision. Therefore, its customer retention capability is considered above average."},"m10_durability":{"score":7,"comment_zh":"STAG Industrial 的業務模式具有較強的持久性。工業地產作為現代經濟的基礎設施，其需求相對穩定，尤其是在電子商務、物流和製造業持續發展的背景下。STAG 專注於美國二三線市場的策略，使其能夠在經濟波動中保持較好的穩定性。雖然利率變動、宏觀經濟下行和行業競爭會帶來挑戰，但其多元化的租戶基礎和穩健的資產管理能力，有助於抵禦外部衝擊。作為一家擁有穩定租金收入和股息支付記錄的 REIT，STAG 的業務模式展現了較強的持久性，構成了一個堅固的護城河。","comment_en":"STAG Industrial's business model exhibits strong durability. Industrial real estate, as a fundamental infrastructure of the modern economy, has relatively stable demand, especially with the continued growth of e-commerce, logistics, and manufacturing. STAG's strategy of focusing on secondary and tertiary markets in the US allows it to maintain good stability during economic fluctuations. While interest rate changes, macroeconomic downturns, and industry competition pose challenges, its diversified tenant base and sound asset management capabilities help mitigate external shocks. As a REIT with a history of stable rental income and dividend payments, STAG's business model demonstrates considerable durability, forming a robust moat."},"overall_moat_verdict_zh":"STAG Industrial 的護城河主要體現在其多元化的工業地產組合、特定市場的地理優勢以及相對較高的租戶轉換成本。作為一家 REIT，其規模效應帶來了一定的成本優勢和運營效率。然而，其業務模式缺乏品牌定價權、專利壁壘和網絡效應，這限制了其護城河的深度。其資本配置能力和客戶保留能力處於中等水平。總體而言，STAG 類似於一個提供穩定租金收入的「收費橋」，其護城河相對堅固，尤其是在其專注的二三線市場，但並非難以逾越的特許經營權。","overall_moat_verdict_en":"STAG Industrial's moat is primarily reflected in its diversified portfolio of industrial properties, geographical advantages in specific markets, and relatively high tenant switching costs. As a REIT, its economies of scale provide certain cost advantages and operational efficiencies. However, its business model lacks brand pricing power, patent barriers, and network effects, which limits the depth of its moat. Its capital allocation capability and customer retention are at a moderate level. Overall, STAG resembles a 'toll bridge' providing stable rental income, with a relatively strong moat, especially in its focused secondary and tertiary markets, but it does not possess an insurmountable franchise.","evidenceHash":"d72f66a2eeb7e71f6a9cc94af2aef7c4634bfb56f0e3e681c1b8cbbb685ab720","assessmentPolicy":"buffett-moat-v3","model":"gemini-2.5-flash-lite","provider":"Vertex AI"},"ratingSources":{"moat":{"reason":null,"evidenceHash":"d72f66a2eeb7e71f6a9cc94af2aef7c4634bfb56f0e3e681c1b8cbbb685ab720","currentEvidenceHash":"d72f66a2eeb7e71f6a9cc94af2aef7c4634bfb56f0e3e681c1b8cbbb685ab720"},"fScore":{"score":5,"checkedAt":null},"zScore":{"asOfDate":"2025-12-31","period":"FY 2025","basis":"comparableAnnual","model":"z","zone":"distress","reason":null,"scoringCurrency":"USD","applicability":null,"checkedAt":"2026-11-08T13:46:54.110Z","evidenceHash":"ecc7d3aa7bbc37d0d982c7d6db149a0ef61ee686d3aee047b4bbb357deac5c2e"},"mScore":{"asOfDate":"2025-12-31","period":"FY 2025","basis":"comparableAnnual","model":null,"zone":"clean","reason":null,"scoringCurrency":"USD","applicability":null,"checkedAt":"2026-11-08T13:46:54.110Z","evidenceHash":"ecc7d3aa7bbc37d0d982c7d6db149a0ef61ee686d3aee047b4bbb357deac5c2e"}},"fin_valuation":{"is_financial":false},"image":"https://images.financialmodelingprep.com/symbol/STAG.png","logo":"https://images.financialmodelingprep.com/symbol/STAG.png","website":"https://www.stagindustrial.com","ceo":"William R. Crooker","full_time_employees":"93","description":"STAG Industrial, Inc. is a real estate investment company, which engages in acquiring, owning, and managing single-tenant, industrial real estate assets. It offers industrial real estate operating platform to real estate ownership. The company was f