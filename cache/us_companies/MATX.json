:219.1,"is_undervalued":false,"pe_trailing":11.8,"pe_forward":10.4,"pb_trailing":2.2,"pb_forward":2,"div_yield":0.7,"ps_ratio":9.4,"fcf_to_ev":2.47,"fcf_to_mcap":2.65,"liab_to_assets":39.9,"cash_to_assets":4.6,"current_ratio":1.1,"roe":18.4,"roa":11.1,"moat":null,"ratingSources":{"moat":{"reason":"analysisUnavailable"},"fScore":{"score":7,"checkedAt":null},"zScore":{"asOfDate":"2025-12-31","period":"FY 2025","basis":"comparableAnnual","model":"z","zone":"safe","reason":null,"scoringCurrency":"USD","applicability":null,"checkedAt":"2026-11-07T05:52:04.457Z","evidenceHash":"7f0aefcf6593c0b4a0a8dd631f0ad330bb61e3965bd0aae09d368c2b97000bae"},"mScore":{"asOfDate":"2025-12-31","period":"FY 2025","basis":"comparableAnnual","model":null,"zone":"clean","reason":null,"scoringCurrency":"USD","applicability":null,"checkedAt":"2026-11-07T05:52:04.457Z","evidenceHash":"7f0aefcf6593c0b4a0a8dd631f0ad330bb61e3965bd0aae09d368c2b97000bae"}},"fin_valuation":{"is_financial":false},"image":"https://images.financialmodelingprep.com/symbol/MATX.png","logo":"https://images.financialmodelingprep.com/symbol/MATX.png","website":"https://www.matson.com","ceo":"Matthew J. Cox","full_time_employees":"4170","description":"Matson, Inc. specializes in providing integrated ocean transportation and logistics solutions. Its Ocean Transportation segment offers crucial ocean freight services connecting the domestic non-contiguous economies of Hawaii, Alaska, and Guam, alongside other island nations within Micronesia. Their diverse cargo includes everything from refrigerated foodstuffs, packaged consumer goods, building materials, and automobiles to livestock, seafood, general sustenance, and a wide array of retail and e-commerce merchandise. Additionally, the company operates an expedited express service facilitating trade between China and Long Beach, California, extending its reach to various South Pacific islands and Okinawa, Japan. Beyond direct shipping, this segment manages comprehensive terminal operations, including container stevedoring, refrigerated cargo handling, inland transport, and container equipment maintenance across key locations in Hawaii (Oahu, Hawaii, Maui, and Kauai) and Alaska (Anchorage, Kodiak, and Dutch Harbor). They also offer vessel management and container transshipment services. Matson's Logistics division delivers a broad spectrum of multimodal transportation brokerage services. These encompass domestic and international rail intermodal, various highway trucking options (long-haul, regional, specialized, flat-bed, less-than-truckload, and expedited freight), less-than-container load consolidation, freight forwarding, warehousing, distribution, and comprehensive supply chain management, including non-vessel operating common carrier freight forwarding. Key clients include the U.S. military, freight forwarders, major retailers, consumer goods companies, and automobile manufacturers. Established in Honolulu, Hawaii, in 1882, the company was formerly known as Alexander & Baldwin Holdings, Inc. before adopting its current name, Matson, Inc., in June 2012.","description_en":"Matson, Inc. specializes in providing integrated ocean transportation and logistics solutions. Its Ocean Transportation segment offers crucial ocean freight services connecting the domestic non-contiguous economies of Hawaii, Alaska, and Guam, alongside other island nations within Micronesia. Their diverse cargo includes everything from refrigerated foodstuffs, packaged consumer goods, building materials, and automobiles to livestock, seafood, general sustenance, and a wide array of retail and e-commerce merchandise. Additionally, the company operates an expedited express service facilitating trade between China and Long Beach, California, extending its reach to various South Pacific islands and Okinawa, Japan. Beyond direct shipping, this segment manages comprehensive terminal operations, including container stevedoring, refrigerated cargo handling, inland transport, and container equipment maintenance across key locations in Hawaii (Oahu, Hawaii, Maui, and Kauai) and Alaska (Anchorage, Kodiak, and Dutch Harbor). They also offer vessel management and container transshipment services. Matson's Logistics division delivers a broad spectrum of multimodal transportation brokerage services. These encompass domestic and international rail intermodal, various highway trucking options (long-haul, regional, specialized, flat-bed, less-than-truckload, and expedited freight), less-than-container load consolidation, freight forwarding, warehousing, distribution, and comprehensive supply chain management, including non-vessel operating common carrier freight forwarding. Key clients include the U.S. military, freight forwarders, major retailers, consumer goods companies, and automobile manufacturers. Established in Honolulu, Hawaii, in 1882, the company was formerly known as Alexander & Baldwin Holdings, Inc. before adopting its current name, Matson, Inc., in June 2012.","description_zh":"Matson, Inc.（美股代碼：MATX）為 Industrials 領域之重要企業，專注於 Marine Shipping 業務，具備清晰之商業壁壘與現金流創造能力。","address":"1411 Sand Island Parkway","city":"Honolulu","state":"HI","zip":"96819","country":"US","phone":"808 848 1211","full_address":"1411 Sand Island Parkway, Honolulu, HI 96819, US","range_52w":"101.98-240.87","year_high":240.87,"year_low":101.98,"all_time_high":0,"all_time_low":101.98,"inst_ownership_pct":null,"insider_ownership_pct":null,"top_holders":[],"insider_trades":[{"date":"2026-10-29","name":"COX MATTHEW J","title":"director, officer: Chairman & CEO","is_buy":false,"action":"S-Sale","shares":280,"price":230.63,"total_val":0.06},{"date":"2026-10-29","name":"COX MATTHEW J","title":"director, officer: Chairman & CEO","is_buy":false,"action":"S-Sale","shares":1290,"price":226.44,"total_val":0.29},{"date":"2026-10-29","name":"COX MATTHEW J","title":"director, officer: Chairman & CEO","is_buy":false,"action":"S-Sale","shares":1560,"price":229.93,"total_val":0.36},{"