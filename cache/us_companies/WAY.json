 = 1.0392","detail_en":"1.1650 × 0.892 = 1.0392","reason":null},{"id":5,"key":"DEPI","category":"折舊","desc":"DEPI 折舊指數","desc_en":"DEPI Depreciation index","weight":0.115,"value":1.1157251126728205,"contribution":0.12830838795737437,"passed":null,"detail":"1.1157 × 0.115 = 0.1283","detail_zh":"1.1157 × 0.115 = 0.1283","detail_en":"1.1157 × 0.115 = 0.1283","reason":null},{"id":6,"key":"SGAI","category":"管銷費用","desc":"SGAI 管銷費用指數","desc_en":"SGAI SG&A index","weight":-0.172,"value":0.9795744699209618,"contribution":-0.1684868088264054,"passed":null,"detail":"0.9796 × -0.172 = -0.1685","detail_zh":"0.9796 × -0.172 = -0.1685","detail_en":"0.9796 × -0.172 = -0.1685","reason":null},{"id":7,"key":"TATA","category":"應計項目","desc":"TATA 總應計項目 / 總資產","desc_en":"TATA Total accruals to total assets","weight":4.679,"value":-0.024939413320426613,"contribution":-0.11669151492627614,"passed":null,"detail":"-0.0249 × 4.679 = -0.1167","detail_zh":"-0.0249 × 4.679 = -0.1167","detail_en":"-0.0249 × 4.679 = -0.1167","reason":null},{"id":8,"key":"LVGI","category":"槓桿","desc":"LVGI 槓桿指數","desc_en":"LVGI Leverage index","weight":-0.327,"value":0.9709853342175663,"contribution":-0.3175122042891442,"passed":null,"detail":"0.9710 × -0.327 = -0.3175","detail_zh":"0.9710 × -0.327 = -0.3175","detail_en":"0.9710 × -0.327 = -0.3175","reason":null}]},"snapshot":null,"model":null}
