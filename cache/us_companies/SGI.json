id":6,"key":"SGAI","category":"管銷費用","desc":"SGAI 管銷費用指數","desc_en":"SGAI SG&A index","weight":-0.172,"value":1.0258635373796314,"contribution":-0.1764485284292966,"passed":null,"detail":"1.0259 × -0.172 = -0.1764","detail_zh":"1.0259 × -0.172 = -0.1764","detail_en":"1.0259 × -0.172 = -0.1764","reason":null},{"id":7,"key":"TATA","category":"應計項目","desc":"TATA 總應計項目 / 總資產","desc_en":"TATA Total accruals to total assets","weight":4.679,"value":-0.03581883933184088,"contribution":-0.1675963492336835,"passed":null,"detail":"-0.0358 × 4.679 = -0.1676","detail_zh":"-0.0358 × 4.679 = -0.1676","detail_en":"-0.0358 × 4.679 = -0.1676","reason":null},{"id":8,"key":"LVGI","category":"槓桿","desc":"LVGI 槓桿指數","desc_en":"LVGI Leverage index","weight":-0.327,"value":0.8084503027003123,"contribution":-0.2643632489830021,"passed":null,"detail":"0.8085 × -0.327 = -0.2644","detail_zh":"0.8085 × -0.327 = -0.2644","detail_en":"0.8085 × -0.327 = -0.2644","reason":null}],"fcf_to_equity":23.81,"liquidation":{"version":1,"ticker":"SGI","currency":"USD","source":"FMP stable balance-sheet-statement and quote","fetchedAt":"2026-10-28T12:55:52.641Z","balanceDate":"2026-06-30","filingDate":"2026-08-07","quoteDate":"2026-10-22","sourceCurrency":"USD","fx":{"rate":1,"basis":"closing","start":null,"end":"2026-06-30","observationDate":"2026-06-30","reason":null},"receivablesBasis":"trade","shareBasis":"commonSharesOutstandingExcludingTreasury","quote":{"currency":"USD","date":"2026-10-22","price":64.685,"marketCap":14893000000},"amounts":{"currentAssets":1289000000,"totalLiabilities":8374000000,"cashAndShortTermInvestments":112000000,"tradeReceivables":361400000,"inventory":649800000,"preferredStock":0},"sharesOutstanding":230239000,"shareSource":{"shares":230.239,"date":"2026-10-21","basis":"commonSharesOutstandingExcludingTreasury","source":"FMP shares-float outstandingShares","providerSource":"https://www.sec.gov/Archives/edgar/data/1206264/000120626426000113/sgi-20260630.htm","capturedAt":"2026-10