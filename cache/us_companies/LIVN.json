v_yield":0,"ps_ratio":10.2,"fcf_to_ev":2.57,"fcf_to_mcap":2.46,"liab_to_assets":49.4,"cash_to_assets":20.8,"current_ratio":1.46,"roe":14.3,"roa":7.2,"moat":null,"ratingSources":{"moat":{"reason":"analysisUnavailable"},"fScore":{"score":7,"checkedAt":null},"zScore":{"asOfDate":"2024-12-31","period":"FY 2024","basis":"comparableAnnual","model":"z","zone":"safe","reason":null,"scoringCurrency":"USD","applicability":null,"checkedAt":"2026-11-28T08:53:00.661Z","evidenceHash":"40d2666b7be160b42ea2f3950e54dc4c622b96cc24242def1b8202a8beb18483"},"mScore":{"asOfDate":"2025-12-31","period":"FY 2025","basis":"comparableAnnual","model":null,"zone":"clean","reason":null,"scoringCurrency":"USD","applicability":null,"checkedAt":"2026-11-28T08:53:00.661Z","evidenceHash":"40d2666b7be160b42ea2f3950e54dc4c622b96cc24242def1b8202a8beb18483"}},"fin_valuation":{"is_financial":false},"image":"https://images.financialmodelingprep.com/symbol/LIVN.png","logo":"https://images.financialmodelingprep.com/symbol/LIVN.png","website":"https://www.livanova.com","ceo":"Vladimir A. Makatsaria","full_time_employees":"3300","description":"LivaNova PLC is a global medical technology company dedicated to developing, manufacturing, and marketing a variety of therapeutic solutions. The company operates through three key segments. Its Cardiopulmonary division provides essential products for heart-lung procedures, such as oxygenators, heart-lung machines, and various perfusion systems. The Neuromodulation segment is known for its VNS Therapy System, an implantable device that delivers vagus nerve stimulation to treat drug-resistant epilepsy, difficult-to-treat depression, and obstructive sleep apnea. This segment is also advancing the VITARIA System, which employs VNS for heart failure, through clinical development. The Advanced Circulatory Support segment offers temporary life support solutions, including both cardiopulmonary and respiratory support technologies. LivaNova serves a wide range of medical professionals, including perfusionists, neurologists, neurosurgeons, and other physicians, as well as hospitals and healthcare providers. The company's products are distributed globally through both its direct sales force and independent distributors. Additionally, LivaNova has a research collaboration with Verily aimed at discovering clinical biomarkers for depression. Founded in 1987, the company is headquartered in London, United Kingdom.","description_en":"LivaNova PLC is a global medical technology company dedicated to developing, manufacturing, and marketing a variety of therapeutic solutions. The company operates through three key segments. Its Cardiopulmonary division provides essential products for heart-lung procedures, such as oxygenators, heart-lung machines, and various perfusion systems. The Neuromodulation segment is known for its VNS Therapy System, an implantable device that delivers vagus nerve stimulation to treat drug-resistant epilepsy, difficult-to-treat depression, and obstructive sleep apnea. This segment is also advancing the VITARIA System, which employs VNS for heart failure, through clinical development. The Advanced Circulatory Support segment offers temporary life support solutions, including both cardiopulmonary and respiratory support technologies. LivaNova serves a wide range of medical professionals, including perfusionists, neurologists, neurosurgeons, and other physicians, as well as hospitals and healthcare providers. The company's products are distributed globally through both its direct sales force and independent distributors. Additionally, LivaNova has a research collaboration with Verily aimed at discovering clinical biomarkers for depression. Founded in 1987, the company is headquartered in London, United Kingdom.","description_zh":"LivaNova PLC（美股代碼：LIVN）為 Healthcare 領域之重要企業，專注於 Medical - Devices 業務，具備清晰之商業壁壘與現金流創造能力。","address":"5220 Valiant Court","city":"Gloucester","state":"GL","zip":"GL3 4FE","country":"GB","phone":"44 20 33