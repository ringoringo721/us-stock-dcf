air_val":-26.39,"default_fair_val":-26.39,"premium_pct":-340.6,"is_undervalued":true,"pe_trailing":24,"pe_forward":21.1,"pb_trailing":0.9,"pb_forward":0.8,"div_yield":3.36,"ps_ratio":169,"fcf_to_ev":0.1,"fcf_to_mcap":0.15,"liab_to_assets":52.5,"cash_to_assets":10.2,"current_ratio":2.38,"roe":-5.2,"roa":-2.3,"moat":null,"ratingSources":{"moat":{"reason":"analysisUnavailable"},"fScore":{"score":5,"checkedAt":null},"zScore":{"asOfDate":"2025-12-31","period":"FY 2025","basis":"comparableAnnual","model":"z","zone":"distress","reason":null,"scoringCurrency":"USD","applicability":null,"checkedAt":"2026-11-07T06:13:46.042Z","evidenceHash":"e4d3c90e273c71cd26d02edcac94e2eb503d5d764750952b4a939a049d8a16bd"},"mScore":{"asOfDate":"2025-12-31","period":"FY 2025","basis":"comparableAnnual","model":null,"zone":"highRisk","reason":null,"scoringCurrency":"USD","applicability":null,"checkedAt":"2026-11-07T06:13:46.042Z","evidenceHash":"e4d3c90e273c71cd26d02edcac94e2eb503d5d764750952b4a939a049d8a16bd"}},"fin_valuation":{"is_financial":false},"image":"https://images.financialmodelingprep.com/symbol/WLK.png","logo":"https://images.financialmodelingprep.com/symbol/WLK.png","website":"https://www.westlake.com","ceo":"Jean-Marc Gilson","full_time_employees":"14600","description":"Westlake Corporation operates as a global producer and supplier of petrochemicals, polymers, and a diverse range of building materials. Its business activities are structured into two main divisions: Performance and Essential Materials, and Housing and Infrastructure Products. The Performance and Essential Materials segment focuses on the manufacture and distribution of various chemical components, including polyethylene, styrene monomer, ethylene co-products, PVC, VCM, ethylene dichloride chlor-alkali, and related chlorinated derivatives. Concurrently, the Housing and Infrastructure Products division manufactures an extensive array of building and consumer goods. These offerings span residential PVC siding, trim, and moldings; roofing applications; decorative stone; windows; PVC decking; various PVC films for items like inflatables, wall coverings, tape, and roofing; polymer composite roof tiles; PVC pipe and fittings; and PVC compounds. This segment also produces consumer and commercial items such as landscape edging, industrial and home matting, marine dock edging, and masonry joint controls. Westlake's broad customer base includes chemical processors, plastics fabricators, smaller construction contractors, municipal entities, and supply warehouses. Their products are integrated into numerous consumer and industrial markets, such as residential construction, flexible and rigid packaging, automotive manufacturing, healthcare, water treatment, coatings, and a wide array of other durable and non-durable goods. Founded in 1986 and headquartered in Houston, Texas, the company adopted its current name, Westlake Corporation, in February 2022, having previously operated as Westlake Chemical Corporation. Westlake Corporation functions as a subsidiary of TTWF LP.","description_en":"Westlake Corporation operates as a global producer and supplier of petrochemicals, polymers, and a diverse range of building materials. Its business activities are structured into two main divisions: Performance and Essential Materials, and Housing and Infrastructure Products. The Performance and Essential Materials segment focuses on the manufacture and distribution of various chemical components, including polyethylene, styrene monomer, ethylene co-products, PVC, VCM, ethylene dichloride chlor-alkali, and related chlorinated derivatives. Concurrently, the Housing and Infrastructure Products division manufactures an extensive array of building and consumer goods. These offerings span residential PVC siding, trim, and moldings; roofing applications; decorative stone; windows; PVC decking; various PVC films for items like inflatables, wall coverings, tape, and roofing; polymer composite roof tiles; PVC pipe and fittings; and PVC compounds. This segment also produces consumer and commercial items such as landscape edging, industrial and home matting, marine dock edging, and masonry joint controls. Westlake's broad customer base includes chemical processors, plastics fabricators, smaller construction contractors, municipal entities, and supply warehouses. Their products are integrated into numerous consumer and industrial markets, such as residential construction, flexible and rigid packaging, automotive manufacturing, healthcare, water treatment, coatings, and a wide array of other durable and non-durable goods. Founded in 1986 and headquartered in Houston, Texas, the company adopted its current name, Westlake Corporation, in February 2022, having previously operated as Westlake Chemical Corporation. Westlake Corporation functions as a subsidiary of TTWF LP.","description_zh":"Westlake Corporation（美股代碼：WLK）為 Basic Materials 領域之重要企業，專注於 Chemicals - Specialty 業務，具備清晰之商業壁壘與現金流創造能力。","address":"2801 Post Oak Boulevard","city":"Houston","state":"TX","zip":"77056","country":"US","phone":"713 960 9111","full_address":"2801 Post Oak Boulevard, Houston, TX 77056, US","range_52w":"56.33-124.23","year_high":124.23,"year_low":56.33,"all_time_high":0,"all_time_low":56.33,"inst_ownership_pct":null,"insider_ownership_pct":null,"top_holders":[],"insider_trades":[{"date":"2026-09-01","name":"Darby Tommy","title":"officer: VP and CAO","is_buy":null,"action":"A-Award","shares":1791,"price":0,"total_val":0},{"date":"2026-08-31","name":"Darby Tommy","title":"Officer / Director","is_buy":null,"action":"","shares":0,"price":0,"total_val":0},{"date":"2026-08-17","name":"Sheets Jeffrey Wayne","title":"director","is_buy":null,"action":"A-Award","shares":2184,"price":0,"total_val":0},{"date":"2026-08-17","name":"Sabat Carolyn Chao","title":"director","is_buy":null,"action":"A-Award","shares":2184,"price":0,"total_val":0},{"date":"2026-08-17","name":"Patel Bhavesh V.","title":"director","is_buy