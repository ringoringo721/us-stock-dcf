cf_to_mcap":7.49,"liab_to_assets":68.4,"cash_to_assets":5.2,"current_ratio":2.35,"roe":16,"roa":5,"moat":null,"ratingSources":{"moat":{"reason":"analysisUnavailable"},"fScore":{"score":6,"checkedAt":null},"zScore":{"asOfDate":"2026-01-31","period":"FY 2026","basis":"comparableAnnual","model":"z","zone":"grey","reason":null,"scoringCurrency":"USD","applicability":null,"checkedAt":"2026-11-07T05:45:06.386Z","evidenceHash":"70917e2d8b4e34714075d9d46430464a087326e309ba10652d497e9289a014ce"},"mScore":{"asOfDate":"2026-01-31","period":"FY 2026","basis":"comparableAnnual","model":null,"zone":"clean","reason":null,"scoringCurrency":"USD","applicability":null,"checkedAt":"2026-11-07T05:45:06.386Z","evidenceHash":"70917e2d8b4e34714075d9d46430464a087326e309ba10652d497e9289a014ce"}},"fin_valuation":{"is_financial":false},"image":"https://images.financialmodelingprep.com/symbol/DY.png","logo":"https://images.financialmodelingprep.com/symbol/DY.png","website":"https://www.dycomind.com","ceo":"Daniel S. Peyovich","full_time_employees":"19556","description":"Dycom Industries, Inc. provides specialty contracting services to the digital infrastructure, telecommunications infrastructure, and utility industries in the United States. It operates through Communications and Building Systems segments. The company offers engineering services to telecommunications providers, including the planning and design of aerial, underground, and buried fiber optic, copper, and coaxial cable systems; placement of cables, related structures, and drop lines for telephone companies and cable multiple system operators; program and project management, and inspection personnel; and wireless networks in connection with the deployment of macro cell and new small cell sites. It also provides construction, maintenance, and installation services, such as placement and splicing of copper, fiber, and coaxial cables; tower construction, lines and antenna installation, foundation and equipment pad construction, and small cell site placement for wireless carriers, as well as equipment installation and material fabrication, and site testing services; underground facility locating services, including locating telephone, cable television, power, water, sewer, and gas lines for utility companies; installation and maintenance of customer premise equipment for electric and gas utilities, and other customers. Dycom Industries, Inc. was incorporated in 1969 and is based in West Palm Beach, Florida.","description_en":"Dycom Industries, Inc. provides specialty contracting services to the digital infrastructure, telecommunications infrastructure, and utility industries in the United States. It operates through Communications and Building Systems segments. The company offers engineering services to telecommunications providers, including the planning and design of aerial, underground, and buried fiber optic, copper, and coaxial cable systems; placement of cables, related structures, and drop lines for telephone companies and cable multiple system operators; program and project management, and inspection personnel; and wireless networks in connection with the deployment of macro cell and new small cell sites. It also provides construction, maintenance, and installation services, such as placement and splicing of copper, fiber, and coaxial cables; tower construction, lines and antenna installation, foundation and equipment pad construction, and small cell site placement for wireless carriers, as well as equipment installation and material fabrication, and site testing services; underground facility locating services, including locating telephone, cable television, power, water, sewer, and gas lines for utility companies; installation and maintenance of customer premise equipment for electric and gas utilities, and other customers. Dycom Industries, Inc. was incorporated in 1969 and is based in West Palm Beach, Florida.","description_zh":"Dycom Industries, Inc.（美股代碼：DY）為 Industrials 領域之重要企業，專注