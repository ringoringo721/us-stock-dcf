el":null,"zone":null,"reason":"financialSectorNotApplicable","scoringCurrency":null,"applicability":"financialSector","checkedAt":"2026-11-07T06:10:46.038Z","evidenceHash":"c06a0a56b4c978876cdc8f93804bbf8ac811c71e8642614e5d86f20634f11327"},"mScore":{"asOfDate":null,"period":null,"basis":null,"model":null,"zone":null,"reason":"financialSectorNotApplicable","scoringCurrency":null,"applicability":"financialSector","checkedAt":"2026-11-07T06:10:46.038Z","evidenceHash":"c06a0a56b4c978876cdc8f93804bbf8ac811c71e8642614e5d86f20634f11327"}},"fin_valuation":{"is_financial":true,"reference":{"date":"2026-09-30","label":"FY 2026 Q3","period":"quarterly","flow":"ttm","balance":"beginning","rote":29.517170762444866,"warnings":[],"tbvps":94.91932715413662,"reason":null},"rote":29.517170762444866,"tbvps":94.91932715413662,"bvps":94.91932715413662,"g":2.25,"dps_total":9.687723646773376,"dps_source":"ttmQuarterly","dps_source_date":"2026-09-30","pb_tangible":2.559015189873418,"ke_floor_pct":9,"ke_floor_applied":true,"ke_capm":5.63,"ke":9,"excess_return_fair":383.43,"ddm_fair":175.88},"image":"https://images.financialmodelingprep.com/symbol/THG.png","logo":"https://images.financialmodelingprep.com/symbol/THG.png","website":"https://www.hanover.com","ceo":"John Conner Roche","full_time_employees":"4900","description":"The Hanover Insurance Group, Inc. (THG) is a U.S.-based insurer offering a wide array of property and casualty coverage through its various operating units. Its operations are organized into three main divisions: Commercial Lines, Personal Lines, and an \"Other\" segment. The Commercial Lines division delivers a comprehensive suite of business insurance solutions, including multi-peril, commercial auto, and workers' compensation policies. It also provides management and professional liability, marine, specialized industrial and commercial property, standalone general liability, surety bonds, umbrella liability, fidelity, crime, and additional commercial protection. Within Personal Lines, customers can access auto and homeowners' insurance, alongside other individual coverages like personal umbrella policies, inland marine, fire, personal watercraft, and personal cyber protection. The \"Other\" segment focuses on delivering investment management expertise to institutions, pension funds, and a range of other organizational clients. Distribution of Hanover's offerings is primarily facilitated by a network of independent agents and brokers. Originally incorporated as Allmerica Financial Corp., the company adopted its current name, The Hanover Insurance Group, Inc., in December 2005. Established in 1852, The Hanover Insurance Group, Inc. maintains its corporate headquarters in Worcester, Massachusetts.","description_en":"The Hanover Insurance Group, Inc. (THG) is a U.S.-based insurer offering a wide array of property and casualty coverage through its various operating units. Its operations are organized into three main divisions: Commercial Lines, Personal Lines, and an \"Other\" segment. The Commercial Lines division delivers a comprehensive suite of business insurance solutions, including multi-peril, commercial auto, and workers' compensation policies. It also provides management and professional liability, marine, specialized industrial and commercial property, standalone general liability, surety bonds, umbrella liability, fidelity, crime, and additional commercial protection. Within Personal Lines, customers can access auto and homeowners' insurance, alongside other individual coverages like personal umbrella policies, inland marine, fire, personal watercraft, and personal cyber protection. The \"Other\" segment focuses on delivering investment management expertise to institutions, pension funds, and a range of other organizational clients. Distribution of Hanover's offerings is primarily facilitated by a network of independent agents and brokers. Originally incorporated as Allmerica Financial Corp., the company adopted its current name, The Hanover Insurance Group, Inc., in December 2005. Established in 1852, The Hanover Insurance Group, Inc. maintains its corporate headquarters in Worcester, Massachusetts.","description_zh":"The Hanover Insurance Group, Inc.（美股代碼：THG）為 Financial Services 領域之重要企業，專注於 Insurance - Property & Casualty 業務，具備清晰之商業壁壘與現金流創造能力。","address":"440 Lincoln Street","city":"Worcester","state":"MA","zip":"01653","country":"US","phone":"508 855 1000","full_address":"440 Lincoln Street, Worcester, MA 01653, US","range_52w":"166.54-256.74","year_high":256.74,"year_low":166.54,"all_time_high":0,"all_time_low":166.54,"inst_ownership_pct":null,"insider_ownership_pct":null,"top_holders":[],"insider_trades":[{"date":"2026-11-05","name":"Bunting Theodore H JR","title":"director","is_buy":null,"action":"G-Gift","shares":450,"price":0,"total_val":0},{"date":"2026-11-05","name":"Lee Willard T","title":"officer: Executive Vice President","is_buy":null,"action":"M-Exempt","shares":3006,"price":139.51,"total_val":0.42},{"date":"2026-11-05","name":"Lee Willard T","title":"officer: Executive Vice President","is_buy":null,"action":"M-Exempt","shares":3579,"price":115.35,"total_val":0.41},{"date":"2026-11-05","name":"Lee Willard T","title":"officer: Executive Vice President","is_buy":null,"action":"M-Exempt","shares":2598,"price":118.54,"total_val":0.31},{"date":"2026-11-05","name":"Lee Willard T","title":"officer: Executive Vice President","is_buy":false,"action":"S-Sale","shares":7636,"price":248.98,"total_val":1.9},{"date":"2026-11-05","name":"Lee Willard T","title":"officer: Executive Vice President","is_buy":null,"action":"M-Exempt","shares":703,"price":117.22,"total_val":0.08},{"date":"2026-11-05","name":"Lee Willard T","title":"officer: Executive Vice President","is_buy":false,"action":"S-Sale","shares":2310,"price":249.69,"total_val":0.58},{"date":"2026-11-05","name":"Lee Willard T","title":"officer: Executive Vice President","is_buy":null,"action":"M-Exempt","shares":3579,"price":115