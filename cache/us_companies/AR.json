"g1":5.4,"g2":3.5,"g":2.25,"wacc":5.43,"ev":15498.6,"fmp_official_ev":15498.6,"dcf_model_ev":51676.1,"ev_to_ebitda":6.5,"debt_to_ebitda":1.93,"net_debt_to_ebitda":1.93,"f_score":7,"f_score_breakdown":[{"id":1,"category":"盈利能力","desc":"資產回報率 ROA > 0","passed":1,"detail":"當期 ROA = 7.1%"},{"id":2,"category":"盈利能力","desc":"營業現金流 CFO > 0","passed":1,"detail":"自由現金流 = $1,410M"},{"id":3,"category":"盈利能力","desc":"資產回報率持續擴張 (ΔROA > 0)","passed":1,"detail":"回報率穩步領先同業基準"},{"id":4,"category":"盈利能力","desc":"應計利潤品質高 (CFO > 淨利潤)","passed":1,"detail":"真實現金流充沛，無虛報帳面獲利"},{"id":5,"category":"槓桿與償債","desc":"財務槓桿未惡化 (ΔLeverage ≤ 0)","passed":1,"detail":"總負債資產比率 = 45.4%"},{"id":6,"category":"槓桿與償債","desc":"短期流動性安全 (ΔLiquidity > 0)","passed":0,"detail":"流動比率 = 0.40"},{"id":7,"category":"槓桿與償債","desc":"股本未遭稀釋 (ΔShares ≤ 0)","passed":1,"detail":"未大幅增發新股割韭菜"},{"id":8,"category":"營運效率","desc":"毛利率擴張 (ΔMargin > 0)","passed":0,"detail":"產品定價權增強，毛利結構健康"},{"id":9,"category":"營運效率","desc":"資產週轉率提升 (ΔTurnover > 0)","passed":1,"detail":"每單位資產產出效益改善"}],"fair_val":153.07,"default_fair_val":153.07,"premium_pct":-75.1,"is_undervalued":true,"pe_trailing":10.8,"pe_forward":9.5,"pb_trailing":1.4,"pb_forward":1.3,"div_yield":0.8,"ps_ratio":2.1,"fcf_to_ev":2.73,"fcf_to_mcap":12.03,"liab_to_assets":45.4,"cash_to_assets":0,"current_ratio":0.4,"roe":13,"roa":7.1,"moat":{"ticker":"AR","period":"2026Q2","m1_brand_pricing":{"score":2,"comment_zh":"AR 的產品是天然氣和石油，屬於大宗商品，缺乏品牌溢價或顯著的定價權。其營收高度依賴市場供需和國際油價波動，而非品牌忠誠度或獨特產品特性。公司在定價上基本是被動接受者，無法顯著影響市場價格，這使得此維度護城河極為薄弱。","comment_en":"Antero Resources operates in the commodity sector (natural gas and oil), lacking significant brand power or pricing influence. Its revenue is primarily dictated by market supply and demand dynamics and global commodity prices, not brand loyalty or unique product features. The company is largely a price taker, unable to materially impact market prices, resulting in a very weak moat in this dimension."},"m2_patents_regulatory":{"score":3,"comment_zh":"能源勘探與生產行業的進入壁壘主要來自於資本密集度、勘探風險和環境法規，而非專利或技術。AR 的競爭優勢不來自專利保護，而是其在特定區域的勘探許可和開採權。雖然監管環境可能構成一定進入門檻，但這並非典型的專利壁壘，且易受政策變動影響。","comment_en":"The energy exploration and production industry's barriers to entry stem from capital intensity, exploration risks, and environmental regulations, rather than patents or proprietary technology. AR's competitive edge doesn't derive from patent protection but from its exploration licenses and extraction rights in specific regions. While the regulatory environment can pose entry hurdles, this is not a typical patent-based moat and is subject to policy changes."},"m3_high_switching_costs":{"score":2,"comment_zh":"AR 的客戶主要是工業用戶和能源交易商，他們購買的是標準化的天然氣和石油產品。這些客戶的轉換成本非常低，可以輕易地從不同的供應商處採購，只要價格和供應條件合適。AR 缺乏與客戶建立的長期、高轉換成本的關係。","comment_en":"AR's customers are primarily industrial users and energy traders who purchase standardized natural gas and oil products. These customers face very low switching costs and can easily source from different suppliers based on price and supply conditions. Antero Resources does not foster long-term relationships with customers that involve high switching costs."},"m4_network_effects":{"score":1,"comment_zh":"天然氣和石油的生產和銷售不涉及網絡效應。AR 的業務模式不依賴於用戶數量的增加來提升產品或服務的價值。其市場地位更多取決於資源儲量、生產效率和市場價格，而非用戶之間的互動或網絡擴張。","comment_en":"The production and sale of natural gas and oil do not involve network effects. AR's business model does not rely on an increasing number of users to enhance the value of its products or services. Its market position is determined more by resource reserves, production efficiency, and market prices, rather than user interactions or network expansion."},"m5_cost_advantage_scale":{"score":7,"comment_zh":"AR 在阿巴拉契亞盆地的 Marcellus 和 Utica 頁岩氣區擁有大規模的生產設施和成熟的基礎設施，這帶來了一定的規模經濟效益。其低成本的生產能力是其競爭優勢的關鍵來源之一，使其能夠在行業週期中保持一定的盈利能力，並在價格壓力下具有一定的韌性。","comment_en":"Antero Resources benefits from large-scale production facilities and established infrastructure in the Marcellus and Utica shale plays of the Appalachian Basin, providing certain economies of scale. Its low-cost production capability is a key source of competitive advantage, enabling it to maintain profitability through industry cycles and exhibit resilience under pricing pressure."},"m6_unique_geography_assets":{"score":7,"comment_zh":"AR 在美國阿巴拉契亞盆地擁有大量且高品質的頁岩氣和頁岩油儲量，特別是在 Marcellus 和 Utica 地區。這些地區的優質地質條件和已開發的基礎設施構成了其重要的資產壁壘，使得新進入者難以複製其資源優勢和低成本開採能力。","comment_en":"Antero Resources holds substantial, high-quality reserves of shale gas and oil, particularly in the Marcellus and Utica regions of the Appalachian Basin. The favorable geological conditions and developed infrastructure in these areas constitute a significant asset barrier, making it difficult for new entrants to replicate its resource advantage and low-cost extraction capabilities."},"m7_operational_efficiency":{"score":7,"comment_zh":"AR 在頁岩氣開採方面展現出較高的營運效率，透過技術創新和流程優化，持續降低單位生產成本。其高效的鑽井和完井技術，以及對生產數據的精準分析，使其能夠在市場波動中保持競爭力，並實現穩定的自由現金流（TTM $1,410.2M）。","comment_en":"Antero Resources demonstrates high operational efficiency in shale gas extraction, continuously reducing per-unit production costs through technological innovation and process optimization. Its efficient drilling and completion techniques, coupled with precise analysis of production data, enable it to remain competitive amidst market volatility and generate stable free cash flow (TTM $1,410.2M)."},"m8_capital_allocation":{"score":6,"comment_zh":"AR 的資本配置策略在過去幾年有所調整，從積極擴張轉向更注重股東回報，包括股票回購和債務償還。儘管其自由現金流表現良好，但公司仍有較高的負債水平 ($4,615.3M)，這限制了其在資本配置上的靈活性。未來能否持續有效地配置資本以平衡增長與財務健康是關鍵。","comment_en":"Antero Resources' capital allocation strategy has evolved, shifting from aggressive expansion towards prioritizing shareholder returns, including share repurchases and debt reduction. Despite strong free cash flow generation, the company carries a significant debt burden ($4.615.3M), which constrains its flexibility. Its future ability to allocate capital effectively, balancing growth with financial health, is crucial."},"m9_customer_retention":{"score":2,"comment_zh":"由於 AR 的產品是標準化的大宗商品，客戶忠誠度不高，轉換成本低。其客戶關係更多基於合約和市場價格，而非產品的獨特性或服務的深度綁定。因此，在客戶留存方面，AR 的護城河非常有限，主要依賴於持續的供應能力和具競爭力的價格。","comment_en":"As Antero Resources deals in standardized commodities, customer loyalty is low, and switching costs are minimal. Customer relationships are primarily based on contracts and market prices rather than product uniqueness or deep service integration. Consequently, AR's moat in customer retention is very limited, relying mainly on consistent supply and competitive pricing."},"m10_durability":{"score":5,"comment_zh":"AR 的業務模式屬於週期性強的能源行業，其長期穩定性受全球能源價格、地緣政治和環保政策影響甚大。雖然其在特定區域的資源儲量和生產效率提供了一定的韌性，但其本質上仍是商品型企業，易受外部宏觀因素衝擊，護城河的持久性面臨挑戰。","comment_en":"Antero Resources operates in the highly cyclical energy sector, making its long-term durability significantly influenced by global energy prices, geopolitical events, and environmental policies. While its resource reserves and production efficiency in specific regions offer some resilience, its fundamentally commodity-based business is susceptible to external macroeconomic shocks, posing challenges to the durability of its moat."},"overall_moat_verdict_zh":"Antero Resources (AR) 是一家位於能源行業的大宗商品生產商，其經濟護城河主要體現在 M5 規模成本和 M6 利基寡占（特定區域資源優勢）上。公司在阿巴拉契亞盆地擁有優質的頁岩氣儲量和成熟的基礎設施，帶來了成本優勢和一定的進入壁壘。然而，其產品的商品屬性導致 M1 定價權、M3 轉換成本和 M9 客戶留存方面護城河極為薄弱，缺乏品牌忠誠度或網絡效應。M2 專利/監管壁壘和 M10 持久性也相對有限，易受政策和市場波動影響。M8 資本配置尚可，但需關注高負債。總體而言，AR 屬於典型的「商品型」企業，其護城河相對狹窄且易受外部環境影響，投資需謹慎評估週期風險。","overall_moat_verdict_en":"Antero Resources (AR) is a commodity producer in the energy sector. Its economic moat primarily resides in its cost advantages from scale (M5) and its niche asset position (M6) within the Appalachian Basin, characterized by high-quality reserves and established infrastructure. However, the commodity nature of its products renders its moat extremely weak in pricing power (M1), switching costs (M3), and customer retention (M9), lacking brand loyalty or network effects. Patent/regulatory barriers (M2) and durability (M10) are also limited, susceptible to policy and market volatility. Capital allocation (M8) is adequate but burdened by significant debt. Overall, AR is a classic 'commodity business' with a narrow moat, highly exposed to external factors, requiring careful assessment of cyclical risks.","evidenceHash":"1cfb3c59b3533465718ed40dbeb4f33f160f180d23bd17d93b8598c6b3d87219","assessmentPolicy":"us-buffett-moat-v3"},"ratingSources":{"moat":{"reason":null},"fScore":{"score":7,"checkedAt":null}},"fin_valuation":{"is_financial":false},"image":"https://images.financialmodelingprep.com/symbol/AR.png","logo":"https://images.financialmodelingprep.com/symbol/AR.png","website":"https://www.anteroresources.com","ceo":"Michael N. Kennedy","full_time_employees":"632","description":"Antero Resources Corporation functions as an independent energy enterprise, primarily engaged in identifying, acquiring, developing, and extracting natural gas, natural gas liquids (NGLs), and crude oil deposits throughout the United States. As of the close of 2021 (December 31st), the company held significant land positions, including roughly 502,000 net acres within the Appalachian Basin and an additional 174,000 net acres in the Upper Devonian Shale. Its infrastructure in the Appalachian Basin also featured 494 miles of operational gas gathering pipelines and 21 compressor stations. The firm's estimated proven reserves were substantial, totaling 17.7 trillion cubic feet of natural gas equivalent. This quantity was composed of 10.2 trillion cubic feet of natural gas, 718 million barrels of ethane expected to be recovered, 501 million barrels of other NGLs (such as propane, isobutane, normal butane, and natural gasoline), and 36 million barrels of oil. Established in 2002, Antero Resources Corporation originally operated under the name Antero Resources Appalachian Corporation, adopting its current identity in June 2013. The company's main office is situated in Denver, Colorado.","description_en":"Antero Resources Corporation functions as an independent energy enterprise, primarily engaged in identifying, acquiring, developing, and extracting natural gas, natural gas liquids (NGLs), and crude oil deposits throughout the United States. As of the close of 2021 (December 31st), the company held significant land positions, including roughly 502,000 net acres within the Appalachian Basin and an additional 174,000 net acres in the Upper Devonian Shale. Its infrastructure in the Appalachian Basin also featured 494 miles of operational gas gathering pipelines and 21 compressor stations. The firm's estimated proven reserves were substantial, totaling 17.7 trillion cubic feet of natural gas equivalent. This quantity was composed of 10.2 trillion cubic feet of natural gas, 718 million barrels of ethane expected to be recovered, 501 million barrels of other NGLs (such as propane, isobutane, normal butane, and natural gasoline), and 36 million barrels of oil. Established in 2002, Antero Resources Corporation originally operated under the name Antero Resources Appalachian Corporation, adopting its current identity in June 2013. The company's main office is situated in Denver, Colorado.","description_zh":"**Antero Resources Corporation (AR) 業務營運概述**\n\nAntero Resources Corporation (AR) 是一家獨立能源公司，專注於美國境內天然氣、天然氣液體 (NGLs) 及原油的探勘、收購、開發與生產。截至 2021 年 12 月 31 日，該公司在阿帕拉契盆地擁有約 50.2 萬淨英畝土地，在上德文紀頁岩 (Upper Devonian Shale) 區域亦有 17.4 萬淨英畝土地。其阿帕拉契盆地基礎設施包含 494 英里營運中的天然氣集輸管線及 21 座壓縮站。\n\n截至同期的探明儲量估計達 17.7 兆立方英尺天然氣當量，其中包含 10.2 兆立方英尺天然氣、預計可回收的 7.18 億桶乙烷、5.01 億桶其他 NGLs（如丙烷、異丁烷、正丁烷及天然汽油），以及 3,600 萬桶原油。公司成立於 2002 年，原名 Antero Resources Appalachian Corporation，於 2013 年 6 月更名為現名。總部位於科羅拉多州丹佛市。","address":"1615 Wynkoop Street","city":"Denver","state":"CO","zip":"80202","country":"US","phone":"303 357 7310","full_address":"1615 Wynkoop Street, Denver, CO 80202, US","range_52w":"29.1-45.75","year_high":45.75,"year_low":29.1,"all_time_high":0,"all_time_low":29.1,"inst_ownership_pct":null,"insider_ownership_pct":null,"top_holders":[],"insider_trades":[{"date":"2026-10-13","name":"Munoz Jeffrey S.","title":"director","is_buy":null,"action":"A-Award","shares":1497,"price":0,"total_val":0},{"date":"2026-10-13","name":"Tyree Thomas B JR","title":"director","is_buy":null,"action":"A-Award","shares":1497,"price":0,"total_val":0},{"date":"2026-10-13","name":"Sutil Vicky","title":"director","is_buy":null,"action":"A-Award","shares":1497,"price":0,"total_val":0},{"date":"2026-10-13","name":"Keenan W Howard JR","title":"director","is_buy":null,"action":"A-Award","shares":1497,"price":0,"total_val":0},{"date":"2026-10-13","name":"Hardesty Benjamin A.","title":"director","is_buy":null,"action":"A-Award","shares":2019,"price":0,"total_val":0},{"date":"2026-10-13","name":"Schroer Brenda R","title":"director","is_buy":null,"action":"A-Award","shares":1497,"price":0,"total_val":0},{"date":"2026-10-13","name":"Mutschler Jacqueline C","title":"director","is_buy":null,"action":"A-Award","shares":1497,"price":0,"total_val":0},{"date":"2026-07-14","name":"Hardesty Benjamin A.","title":"director","is_buy":null,"action":"A-Award","shares":2181,"price":0,"total_val":0},{"date":"2026-07-14","name":"Schroer Brenda R","title":"director","is_buy":null,"action":"A-Award","shares":1617,"price":0,"total_val":0},{"date":"2026-07-14","name":"Keenan W Howard JR","title":"director","is_buy":null,"action":"A-Award","shares":1617,"price":0,"total_val":0}],"stock_splits":[],"fmp_symbol":"AR","real_5y_prices":[],"historical_dcf_series":[],"name_en":"Antero Resources Corporation","expansion":{"status":"available","capturedAt":"2026-10-22T14:29:29.857Z","reason":null,"detailPath":"cache/us_companies/AR.json"}},"snapshot":null,"model":null}
