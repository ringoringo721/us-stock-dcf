wth_10y":[5.4,4.9,4.4,4,3.8,3.5,3.2,2.9,2.6,2.2],"g1":5.4,"g2":3.5,"g":2.25,"wacc":8.09,"ev":44314.6,"fmp_official_ev":44314.6,"dcf_model_ev":41727.3,"ev_to_ebitda":7,"debt_to_ebitda":2.02,"net_debt_to_ebitda":1.87,"f_score":6,"f_score_breakdown":[{"id":1,"category":"盈利能力","desc":"資產回報率 ROA > 0","passed":1,"detail":"當期 ROA = 4.4%"},{"id":2,"category":"盈利能力","desc":"營業現金流 CFO > 0","passed":1,"detail":"自由現金流 = $2,110M"},{"id":3,"category":"盈利能力","desc":"資產回報率持續擴張 (ΔROA > 0)","passed":0,"detail":"回報率穩步領先同業基準"},{"id":4,"category":"盈利能力","desc":"應計利潤品質高 (CFO > 淨利潤)","passed":0,"detail":"真實現金流充沛，無虛報帳面獲利"},{"id":5,"category":"槓桿與償債","desc":"財務槓桿未惡化 (ΔLeverage ≤ 0)","passed":1,"detail":"總負債資產比率 = 51.6%"},{"id":6,"category":"槓桿與償債","desc":"短期流動性安全 (ΔLiquidity > 0)","passed":1,"detail":"流動比率 = 1.39"},{"id":7,"category":"槓桿與償債","desc":"股本未遭稀釋 (ΔShares ≤ 0)","passed":1,"detail":"未大幅增發新股割韭菜"},{"id":8,"category":"營運效率","desc":"毛利率擴張 (ΔMargin > 0)","passed":0,"detail":"產品定價權增強，毛利結構健康"},{"id":9,"category":"營運效率","desc":"資產週轉率提升 (ΔTurnover > 0)","passed":1,"detail":"每單位資產產出效益改善"}],"fair_val":62.7,"default_fair_val":62.7,"premium_pct":8.6,"is_undervalued":false,"pe_trailing":13.7,"pe_forward":12.1,"pb_trailing":1.3,"pb_forward":1.2,"div_yield":3.24,"ps_ratio":3.9,"fcf_to_ev":4.76,"fcf_to_mcap":6.49,"liab_to_assets":51.6,"cash_to_assets":1.7,"current_ratio":1.39,"roe":9.2,"roa":4.4,"moat":{"ticker":"NTR","period":"2026Q2","m1_brand_pricing":{"score":5,"comment_zh":"Nutrien 在肥料和農產品零售領域擁有一定的品牌聲譽，但其產品本質上仍偏向大宗商品，定價權相對有限。雖然其龐大的零售網絡和品牌知名度能帶來一定的定價優勢，尤其是在與獨立農戶打交道時，但面對大型農業企業和全球商品價格波動時，其議價能力受到限制。品牌忠誠度雖有，但農戶仍會權衡價格與產品質量，因此品牌壁壘並非絕對。","comment_en":"Nutrien possesses some brand recognition in fertilizer and agricultural retail, but its products are largely commodity-based, limiting pricing power. Its extensive retail network and brand awareness offer some pricing advantages, particularly with independent farmers. However, its bargaining power is constrained by large agricultural corporations and global commodity price fluctuations. While brand loyalty exists, farmers also consider price and product quality, making the brand barrier not absolute."},"m2_patents_regulatory":{"score":3,"comment_zh":"Nutrien 的業務模式主要依賴於大規模生產和分銷標準化肥料產品，而非依賴專利技術。雖然公司可能擁有某些生產工藝的專利，但這些專利對其整體競爭格局的影響相對較小。行業監管（如環保法規）確實存在，但這更多是運營成本和合規要求，而非構成顯著的進入壁壘或專有技術優勢。","comment_en":"Nutrien's business model relies on large-scale production and distribution of standardized fertilizer products, rather than patented technologies. While the company may hold patents for certain production processes, their impact on its overall competitive landscape is relatively minor. Industry regulations, such as environmental laws, do exist, but these represent operational costs and compliance requirements rather than significant barriers to entry or proprietary technological advantages."},"m3_high_switching_costs":{"score":6,"comment_zh":"對於農戶而言，轉換肥料供應商的成本相對較高。這不僅涉及尋找新供應商、建立關係，還可能需要調整種植計劃和施肥方案。Nutrien 龐大的零售網絡和提供的綜合服務（如技術支持、信貸）進一步增加了農戶的轉換難度。一旦農戶與 Nutrien 建立穩定的合作關係並依賴其供應鏈，轉換的機會成本和實際成本都會顯著上升。","comment_en":"Switching fertilizer suppliers involves considerable costs for farmers, including finding new vendors, establishing relationships, and potentially adjusting planting and fertilization plans. Nutrien's extensive retail network and integrated services, such as technical support and credit, further increase the difficulty of switching. Once farmers establish a stable relationship and rely on Nutrien's supply chain, the opportunity and actual costs of switching become significant."},"m4_network_effects":{"score":3,"comment_zh":"Nutrien 的網絡效應主要體現在其龐大的分銷和零售網絡上。更多的零售點和服務中心能吸引更多農戶，而更多的農戶則能支持更廣泛的網絡和更具競爭力的採購。然而，這種網絡效應並非典型的「使用者越多，價值越大」的強網絡效應，其核心競爭力更多來自於規模和效率，而非用戶間的互動。","comment_en":"Nutrien's network effects are primarily evident in its vast distribution and retail network. More retail locations and service centers attract more farmers, and a larger farmer base supports a broader network and more competitive purchasing. However, this is not a typical strong network effect where 'more users mean more value.' Its core competitiveness stems more from scale and efficiency than from user interaction."},"m5_cost_advantage_scale":{"score":9,"comment_zh":"Nutrien 作為全球最大的農業投入品供應商之一，其規模經濟效應極為顯著。公司在原材料採購、生產製造、物流運輸和分銷網絡方面擁有巨大的成本優勢。這種規模化的運營能力使其能夠以更低的單位成本生產和銷售肥料，從而在價格上對競爭對手構成壓力，並在行業整合中佔據有利地位。","comment_en":"As one of the world's largest suppliers of agricultural inputs, Nutrien benefits from significant economies of scale. The company holds substantial cost advantages in raw material procurement, manufacturing, logistics, and distribution. This scaled operational capability allows it to produce and sell fertilizers at a lower unit cost, exerting pricing pressure on competitors and positioning it favorably in industry consolidation."},"m6_unique_geography_assets":{"score":7,"comment_zh":"Nutrien 擁有全球領先的鉀肥和氮肥礦藏，這些是生產肥料的關鍵原材料。這些礦產資源的地理位置和儲量是其重要的資產壁壘。特別是其鉀肥業務，在全球供應中佔據重要地位。雖然其他公司也擁有礦產資源，但 Nutrien 的礦藏規模、質量和戰略位置使其在供應鏈中具有獨特的優勢。","comment_en":"Nutrien owns world-leading potash and nitrogen mineral reserves, which are critical raw materials for fertilizer production. The geographical location and reserves of these mineral resources represent a significant asset barrier. Its potash business, in particular, holds a crucial position in global supply. While other companies also possess mineral resources, Nutrien's scale, quality, and strategic location of its deposits provide a unique advantage in the supply chain."},"m7_operational_efficiency":{"score":8,"comment_zh":"Nutrien 在其龐大的生產和分銷網絡中展現出卓越的運營效率。公司持續投資於技術升級和流程優化，以降低生產成本、提高產品質量並確保供應鏈的穩定性。其整合的零售網絡能夠高效地將產品送達農戶，並提供增值服務，這得益於其精細化的運營管理和對市場需求的快速響應能力。","comment_en":"Nutrien demonstrates exceptional operational efficiency across its vast production and distribution network. The company continuously invests in technological upgrades and process optimization to reduce production costs, enhance product quality, and ensure supply chain stability. Its integrated retail network efficiently delivers products to farmers and provides value-added services, a testament to its refined operational management and rapid responsiveness to market demands."},"m8_capital_allocation":{"score":7,"comment_zh":"Nutrien 的資本配置策略相對穩健，注重在維持核心業務增長的同時，通過股息和股票回購回報股東。公司在擴大產能、優化運營和進行戰略性收購之間取得平衡。雖然其 ROE 和 ROA 處於中等水平，但其自由現金流表現強勁，為其資本配置提供了彈性，使其能夠在市場機會出現時進行投資。","comment_en":"Nutrien's capital allocation strategy is relatively sound, focusing on maintaining core business growth while returning value to shareholders through dividends and share buybacks. The company balances capacity expansion, operational optimization, and strategic acquisitions. While its ROE and ROA are moderate, its strong free cash flow provides flexibility for capital allocation, enabling investments when market opportunities arise."},"m9_customer_retention":{"score":6,"comment_zh":"Nutrien 通過其廣泛的零售網絡、可靠的產品質量和增值服務（如農藝諮詢、數字農業解決方案）來維持客戶忠誠度。與農戶建立長期合作關係，並提供一站式服務，有助於提高客戶黏性。然而，由於肥料產品的商品化屬性，價格仍然是影響客戶保留的重要因素，尤其是在市場供應充足時。","comment_en":"Nutrien maintains customer loyalty through its extensive retail network, reliable product quality, and value-added services like agronomic advice and digital agriculture solutions. Building long-term relationships with farmers and offering one-stop solutions enhances customer stickiness. However, due to the commodity nature of fertilizers, price remains a significant factor influencing customer retention, especially when market supply is abundant."},"m10_durability":{"score":7,"comment_zh":"農業是人類生存的基礎，對肥料的需求具有內在的穩定性和持久性。Nutrien 作為全球領先的肥料生產商和供應商，處於這個基本行業的核心。儘管會受到農業週期、天氣和商品價格波動的影響，但其業務的長期需求相對穩定。公司擁有的關鍵礦產資源和龐大的分銷網絡，也為其業務的持久性提供了保障。","comment_en":"Agriculture is fundamental to human survival, creating inherent stability and durability in the demand for fertilizers. Nutrien, as a leading global producer and supplier, is at the core of this essential industry. Despite being subject to agricultural cycles, weather, and commodity price fluctuations, the long-term demand for its products remains relatively stable. The company's ownership of key mineral resources and its extensive distribution network further secure the durability of its business."},"overall_moat_verdict_zh":"Nutrien 的護城河主要建立在其龐大的規模經濟和關鍵礦產資源之上，這使其在成本和供應鏈方面具有顯著優勢，屬於典型的「成本領先型」企業。其廣泛的零售網絡和提供的綜合服務，也構成了中等強度的轉換成本壁壘，有助於維持客戶關係。然而，其產品的商品化屬性限制了定價權，且網絡效應不顯著。總體而言，Nutrien 擁有堅固的護城河，尤其是在大宗商品肥料領域，但其增長潛力可能受限於行業週期性和對大宗商品價格的依賴。","overall_moat_verdict_en":"Nutrien's moat is primarily built upon significant economies of scale and control over key mineral resources, granting it substantial cost and supply chain advantages, characteristic of a 'cost-leader' business. Its extensive retail network and integrated services create moderate switching cost barriers, aiding customer retention. However, the commodity nature of its products limits pricing power, and network effects are not pronounced. Overall, Nutrien possesses a solid moat, particularly in the bulk fertilizer segment, though its growth potential may be constrained by industry cyclicality and reliance on commodity prices.","evidenceHash":"cccab81e92f7509f03535064a43309fb523413c26a2315651778ad1e8328c631","assessmentPolicy":"us-buffett-moat-v3"},"ratingSources":{"moat":{"reason":null},"fScore":{"score":6,"checkedAt":null},"zScore":{"asOfDate":"2025-12-31","period":"FY 2025","basis":"comparableAnnual","model":"z","zone":"grey","reason":null,"scoringCurrency":"USD","applicability":null,"checkedAt":"2026-10-28T14:40:26.418Z","evidenceHash":"3b3dccabc83b7c9487a30d3a46aa00ef9028db15309888a8f3e2761b892304d2"},"mScore":{"asOfDate":"2025-12-31","period":"FY 2025","basis":"comparableAnnual","model":null,"zone":"clean","reason":null,"scoringCurrency":"USD","applicability":null,"checkedAt":"2026-10-28T14:40:26.418Z","evidenceHash":"3b3dccabc83b7c9487a30d3a46aa00ef9028db15309888a8f3e2761b892304d2"}},"fin_valuation":{"is_financial":false},"image":"https://images.financialmodelingprep.com/symbol/NTR.png","logo":"https://images.financialmodelingprep.com/symbol/NTR.png","website":"https://www.nutrien.com","ceo":"Kenneth A. Seitz","full_time_employees":"25500","description":"Nutrien Ltd., a company established in 2017 and based in Saskatoon, Canada, functions as a principal supplier of essential agricultural resources and associated services. The firm furnishes vital crop inputs, including various fertilizer compounds like potash, nitrogen, phosphate, and sulfate, in addition to offering financial solutions to its clientele. Its operations involve the extensive distribution of crop-related products such as nutrients, protection agents, seeds, and general merchandise. This is facilitated through a vast network of nearly 2,000 retail establishments situated across the United States, Canada, South America, and Australia. Beyond its retail footprint, Nutrien also engages directly with agricultural producers, delivering personalized services through its numerous farm centers located throughout North America, South America, and Australia.","description_en":"Nutrien Ltd., a company established in 2017 and based in Saskatoon, Canada, functions as a principal supplier of essential agricultural resources and associated services. The firm furnishes vital crop inputs, including various fertilizer compounds like potash, nitrogen, phosphate, and sulfate, in addition to offering financial solutions to its clientele. Its operations involve the extensive distribution of crop-related products such as nutrients, protection agents, seeds, and general merchandise. This is facilitated through a vast network of nearly 2,000 retail establishments situated across the United States, Canada, South America, and Australia. Beyond its retail footprint, Nutrien also engages directly with agricultural producers, delivering personalized services through its numerous farm centers located throughout North America, South America, and Australia.","description_zh":"**Nutrien Ltd. (NTR) 業務營運概述**\n\nNutrien Ltd. 成立於 2017 年，總部位於加拿大薩斯卡通，是全球領先的農業資源與相關服務供應商。公司核心業務聚焦於提供關鍵的作物投入品，包括鉀肥、氮肥、磷肥及硫肥等各類肥料化合物，並輔以農業金融解決方案。\n\n其營運模式涵蓋廣泛的作物相關產品分銷，如營養劑、保護劑、種子及一般農用商品。此分銷網絡遍及美國、加拿大、南美洲及澳洲，擁有近 2,000 家零售據點。此外，Nutrien 透過其在北美、南美及澳洲的眾多農場中心，直接與農民合作，提供個人化的專業服務與技術支援，以優化作物生產效率與永續性。","address":"211 19th Street East","city":"Saskatoon","state":"SK","zip":"S7K 5R6","country":"CA","phone":"13069338523","full_address":"211 19th Street East, Saskatoon, SK S7K 5R6, CA","range_52w":"53.03-85.36","year_high":85.36,"year_low":53.03,"all_time_high":0,"all_time_low":53.03,"inst_ownership_pct":null,"insider_ownership_pct":null,"top_holders":[],"insider_trades":[{"date":"2004-06-29","name":"White Thomas William","title":"director","is_buy":null,"action":"","shares":0,"price":0,"total_val":0},{"date":"2004-06-29","name":"Sherman Jerome F","title":"director","is_buy":null,"action":"","shares":0,"price":0,"total_val":0},{"date":"2004-06-29","name":"Pembroke Mary Dwyer","title":"director","is_buy":null,"action":"","shares":0,"price":0,"total_val":0},{"date":"2004-06-29","name":"Norcutt Steven G","title":"director","is_buy":null,"action":"","shares":0,"price":0,"total_val":0},{"date":"2004-06-25","name":"Wirth Michael I","title":"officer: CFO, Exec. VP, Sec. & Treas.","is_buy":true,"action":"P-Purchase","shares":100,"price":8.75,"total_val":0},{"date":"2004-06-25","name":"Redlingshafer Raymond A JR","title":"director, officer: President & CIO","is_buy":true,"action":"P-Purchase","shares":100,"price":8.75,"total_val":0},{"date":"2004-06-25","name":"Fierro Joseph V","title":"officer: COO - The N.Y. Mort. Co., LLC","is_buy":true,"action":"P-Purchase","shares":100,"price":8.75,"total_val":0},{"date":"2004-06-25","name":"Akre David A","title":"director, officer: Co-Chief Executive Officer","is_buy":null,"action":"L-Small","shares":100,"price":8.75,"total_val":0},{"date":"2004-06-23","name":"Wirth Michael I","title":"officer: CFO, Exec. VP, Sec. & Treas.","is_buy":null,"action":"","shares":0,"price":0,"total_val":0},{"date":"2004-06-23","name":"Redlingshafer Raymond A JR","title":