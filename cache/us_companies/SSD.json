railing":3.8,"pb_forward":3.4,"div_yield":0.45,"ps_ratio":6,"fcf_to_ev":4.2,"fcf_to_mcap":4.14,"liab_to_assets":31.3,"cash_to_assets":15.7,"current_ratio":3.37,"roe":17.7,"roa":12.2,"moat":null,"ratingSources":{"moat":{"reason":"analysisUnavailable"},"fScore":{"score":8,"checkedAt":null},"zScore":{"asOfDate":"2025-12-31","period":"FY 2025","basis":"comparableAnnual","model":"z","zone":"superRobust","reason":null,"scoringCurrency":"USD","applicability":null,"checkedAt":"2026-11-07T06:09:18.333Z","evidenceHash":"a5059c3f7c17bef9a6dc0b570d3f20caedba767a4628713669541b6d2cd7b486"},"mScore":{"asOfDate":"2025-12-31","period":"FY 2025","basis":"comparableAnnual","model":null,"zone":"clean","reason":null,"scoringCurrency":"USD","applicability":null,"checkedAt":"2026-11-07T06:09:18.333Z","evidenceHash":"a5059c3f7c17bef9a6dc0b570d3f20caedba767a4628713669541b6d2cd7b486"}},"fin_valuation":{"is_financial":false},"image":"https://images.financialmodelingprep.com/symbol/SSD.png","logo":"https://images.financialmodelingprep.com/symbol/SSD.png","website":"https://www.simpsonmfg.com","ceo":"Michael L. Olosky","full_time_employees":"5545","description":"Simpson Manufacturing Co., Inc., through its various divisions, stands as a prominent entity specializing in the conceptualization, engineering, production, and distribution of vital components for both wood and concrete construction projects. The company offers an extensive catalog of products for timber and light-frame construction. This includes a robust selection of connectors, strong truss plates, advanced fastening solutions, and a variety of fasteners, alongside essential shearwalls and pre-engineered lateral bracing systems. These items are tailored for traditional wood framing, specialized timber construction, and modern offsite building methodologies. For concrete applications, Simpson provides a comprehensive suite of materials. This encompasses mechanical and adhesive anchoring systems, specialized chemical compounds, carbide drill bits, and powder-actuated tools. Their offerings also extend to fiber-reinforced substances and a range of repair and protective agents, such as adhesives, grouts, sealers, coatings, mortars, fiberglass and fiber-reinforced polymer systems, and asphalt-based products. These are critical for the construction, repair, reinforcement, and protection of concrete, masonry, and steel structures. Moreover, their connector and lateral system expertise also supports structural steel and cold-formed steel frameworks. Beyond physical products, Simpson Manufacturing delivers specialized engineering and design consultation services. They also develop sophisticated software tools aimed at simplifying the process of product specification, selection, and effective deployment for their clientele. The company caters to a diverse customer base, including residential builders, light industrial and commercial construction firms, remodeling contractors, and even the do-it-yourself market. Its global footprint is substantial, encompassing the United States and Canada, a wide array of European nations (France, the United Kingdom, Germany, Denmark, Switzerland, Portugal, Poland, the Netherlands, Belgium, Spain, Sweden, and Norway), and key Asia-Pacific markets (Australia, New Zealand, China, Taiwan, and Vietnam). Established in 1956, Simpson Manufacturing Co., Inc. is headquartered in Pleasanton, California.","description_en":"Simpson Manufacturing Co., Inc., through its various divisions, stands as a prominent entity specializing in the conceptualization, engineering, production, and distribution of vital components for both wood and concrete construction projects. The company offers an extensive catalog of products for timber and light-frame construction. This includes a robust selection of connectors, strong truss plates, advanced fastening solutions, and a variety of fasteners, alongside essential shearwalls and pre-engineered lateral bracing systems. These items are tailored for traditional wood framing, specialized timber construction, and modern offsite building methodologies. For concrete applications, Simpson provides a comprehensive suite of materials. This encompasses mechanical and adhesive anchoring systems, specialized chemical compounds, carbide drill bits, and powder-actuated tools. Their offerings also extend to fiber-reinforced substances and a range of repair and protective agents, such as adhesives, grouts, sealers, coatings, mortars, fiberglass and fiber-reinforced polymer systems, and asphalt-based products. These are critical for the construction, repair, reinforcement, and protection of concrete, masonry, and steel structures. Moreover, their connector and lateral system expertise also supports structural steel and cold-formed steel frameworks. Beyond physical products, Simpson Manufacturing delivers specialized engineering and design consultation services. They also develop sophisticated software tools aimed at simplifying the process of product specification, selection, and effective deployment for their clientele. The company caters to a diverse customer base, including residential builders, light industrial and commercial construction firms, remodeling contractors, and even the do-it-yourself market. Its global footprint is substantial, encompassing the United States and Canada, a wide array of European nations (France, the United Kingdom, Germany, Denmark, Switzerland, Portugal, Poland, the Netherlands, Belgium, Spain, Sweden, and Norway), and key Asia-Pacific markets (Australia, New Zealand, China, Taiwan, and Vietnam). Established in 1956, Simpson Manufacturing Co., Inc. is headquartered in Pleasanton, California.","description_zh":"Simpson Manufacturing Co., Inc.（美股代碼：SSD）為 Basic Materials 領域之重要企業，專注於 Construction Materials 業務，具備清晰之商業壁壘與現金流創造能力。","address":"5956 West Las Positas Boulevard","city":"Pleasanton","state":"CA","zip":"94588","country":"US","phone":"925 560 9000","full_address":"5956 West Las Positas Bo