,"kd":4.5,"tax":21,"growth_10y":[5.4,4.9,4.4,4,3.8,3.5,3.2,2.9,2.6,2.2],"g1":5.4,"g2":3.5,"g":2.25,"wacc":7.08,"ev":25062.3,"fmp_official_ev":25062.3,"dcf_model_ev":20583,"ev_to_ebitda":16,"debt_to_ebitda":5.57,"net_debt_to_ebitda":5.12,"f_score":6,"f_score_breakdown":[{"id":1,"category":"盈利能力","desc":"資產回報率 ROA > 0","passed":1,"detail":"當期 ROA = 3.0%"},{"id":2,"category":"盈利能力","desc":"營業現金流 CFO > 0","passed":1,"detail":"自由現金流 = $858M"},{"id":3,"category":"盈利能力","desc":"資產回報率持續擴張 (ΔROA > 0)","passed":0,"detail":"回報率穩步領先同業基準"},{"id":4,"category":"盈利能力","desc":"應計利潤品質高 (CFO > 淨利潤)","passed":1,"detail":"真實現金流充沛，無虛報帳面獲利"},{"id":5,"category":"槓桿與償債","desc":"財務槓桿未惡化 (ΔLeverage ≤ 0)","passed":1,"detail":"總負債資產比率 = 48.0%"},{"id":6,"category":"槓桿與償債","desc":"短期流動性安全 (ΔLiquidity > 0)","passed":1,"detail":"流動比率 = 5.23"},{"id":7,"category":"槓桿與償債","desc":"股本未遭稀釋 (ΔShares ≤ 0)","passed":1,"detail":"未大幅增發新股割韭菜"},{"id":8,"category":"營運效率","desc":"毛利率擴張 (ΔMargin > 0)","passed":0,"detail":"產品定價權增強，毛利結構健康"},{"id":9,"category":"營運效率","desc":"資產週轉率提升 (ΔTurnover > 0)","passed":0,"detail":"每單位資產產出效益改善"}],"fair_val":18.7,"default_fair_val":18.7,"premium_pct":23.6,"is_undervalued":false,"pe_trailing":25.6,"pe_forward":22.5,"pb_trailing":1.5,"pb_forward":1.4,"div_yield":4.68,"ps_ratio":4.5,"fcf_to_ev":4.17,"fcf_to_mcap":5.53,"liab_to_assets":48,"cash_to_assets":3.5,"current_ratio":5.23,"roe":5.9,"roa":3,"moat":{"ticker":"KIM","period":"2026Q2","m1_brand_pricing":{"score":5,"comment_zh":"KIM 作為美國最大的零售 REIT 之一，其品牌效應主要體現在其所擁有的購物中心網絡的吸引力上。然而，零售 REIT 的定價權相對有限，尤其是在面對電商競爭和消費者習慣變遷時。KIM 的租金收入相對穩定，但大幅提高租金的能力受到市場租賃環境和租戶支付能力的制約。其品牌價值更多體現在資產的質量和地理位置上，而非強勢的品牌溢價能力。","comment_en":"KIM, as one of the largest retail REITs in the US, derives brand effect from the attractiveness of its shopping center network. However, pricing power for retail REITs is inherently limited, especially against e-commerce competition and evolving consumer habits. While KIM's rental income is relatively stable, its ability to significantly increase rents is constrained by market leasing conditions and tenant affordability. Its brand value is more tied to asset quality and location than to strong pricing power."},"m2_patents_regulatory":{"score":1,"comment_zh":"零售 REIT 業務模式不涉及專利或特許經營權，因此在這一維度上幾乎沒有護城河。其運營依賴於對房地產市場的理解、資產管理能力以及與租戶的關係，這些都不屬於專利或監管壁壘的範疇。","comment_en":"The business model of a retail REIT does not involve patents or regulatory licenses, thus offering virtually no moat in this dimension. Its operations rely on real estate market understanding, asset management capabilities, and tenant relationships, none of which fall under patent or regulatory barriers."},"m3_high_switching_costs":{"score":6,"comment_zh":"對於租戶而言，搬離 KIM 的購物中心並尋找新的經營場所存在一定的轉換成本，包括裝修、重新佈局、客戶遷移以及潛在的業務中斷。然而，這些成本並非高到足以形成堅固的壁壘，尤其是在租賃合約到期時，租戶仍有較大的選擇空間。KIM 的策略是通過提供優質的購物體驗和多元化的租戶組合來降低租戶的流失率。","comment_en":"For tenants, relocating from a KIM shopping center involves certain switching costs, including renovation, reconfiguration, customer migration, and potential business disruption. However, these costs are not high enough to form a strong barrier, especially at lease expiration when tenants have considerable options. KIM's strategy focuses on retaining tenants by offering a quality shopping experience and a diversified tenant mix."},"m4_network_effects":{"score":4,"comment_zh":"KIM 的網絡效應體現在其龐大的購物中心網絡和租戶組合上。一個成功的購物中心能吸引更多人流，從而吸引更多租戶，形成正向循環。然而，這種網絡效應在零售 REIT 領域並不像社交媒體或市場平台那樣顯著，且容易受到單一購物中心表現的影響。其網絡效應更多是地理位置和租戶組合的協同作用。","comment_en":"KIM's network effect is reflected in its extensive network of shopping centers and tenant mix. A successful center attracts more foot traffic, which in turn attracts more tenants, creating a positive feedback loop. However, this network effect is less pronounced in the retail REIT sector compared to social media or marketplaces and is susceptible to the performance of individual centers. Its network effect is more about the synergy of location and tenant composition."},"m5_cost_advantage_scale":{"score":7,"comment_zh":"作為美國最大的零售 REIT 之一，KIM 受益於規模經濟帶來的成本優勢。其龐大的資產組合使其在採購、融資、物業管理和營銷方面能夠獲得更優惠的條款。這種規模有助於降低單位運營成本，並在與較小的競爭對手相比時，提供一定的成本競爭力。","comment_en":"As one of the largest retail REITs in the US, KIM benefits from cost advantages derived from economies of scale. Its substantial portfolio allows for more favorable terms in procurement, financing, property management, and marketing. This scale helps reduce per-unit operating costs and provides a cost competitive edge against smaller rivals."},"m6_unique_geography_assets":{"score":8,"comment_zh":"KIM 擁有大量位於高增長市場和人口稠密地區的優質零售資產，這些地理位置的獨特性構成了其重要的護城河。這些黃金地段的稀缺性使得競爭對手難以複製。其對特定區域市場的深入了解和佈局，使其能夠更好地滿足當地消費者需求，從而維持較高的出租率和租金水平。","comment_en":"KIM possesses a significant portfolio of high-quality retail assets located in high-growth markets and densely populated areas. The uniqueness of these geographical locations forms a crucial moat. The scarcity of such prime locations makes them difficult for competitors to replicate. Its deep understanding and strategic positioning within specific regional markets enable it to better cater to local consumer demands, thereby maintaining high occupancy rates and rental levels."},"m7_operational_efficiency":{"score":7,"comment_zh":"KIM 在物業管理和運營效率方面表現出色，這得益於其成熟的管理體系和對技術的應用。通過精細化的運營，公司能夠有效控制成本，優化資產表現，並提升租戶滿意度。其 F-Score 為 6，顯示其財務狀況相對穩健，這也間接反映了其運營效率。","comment_en":"KIM demonstrates strong performance in property management and operational efficiency, attributed to its established management systems and technology adoption. Through meticulous operations, the company effectively controls costs, optimizes asset performance, and enhances tenant satisfaction. Its F-Score of 6 indicates a relatively sound financial position, indirectly reflecting its operational efficiency."},"m8_capital_allocation":{"score":7,"comment_zh":"KIM 在資本配置方面展現出較為審慎和有效的策略。公司通過再投資於現有資產的升級改造、選擇性地收購優質資產以及適度的股息發放來平衡增長與回報。其較高的自由現金流（FCF TTM: $857.5M）為其提供了資本配置的彈性，儘管其負債水平需要關注。","comment_en":"KIM exhibits a prudent and effective strategy in capital allocation. The company balances growth and returns through reinvestment in upgrading existing assets, selective acquisition of quality properties, and moderate dividend payouts. Its substantial free cash flow (FCF TTM: $857.5M) provides flexibility for capital deployment, although its debt levels warrant attention."},"m9_customer_retention":{"score":6,"comment_zh":"KIM 通過提供差異化的購物體驗、引入多元化的租戶組合以及積極的租戶關係管理來維持客戶（租戶）的忠誠度。其對租戶需求的理解和靈活性，有助於延長租賃合約並減少空置率。然而，零售行業的固有波動性和租戶的經營壓力，使得客戶留存並非絕對穩固。","comment_en":"KIM maintains tenant loyalty through differentiated shopping experiences, a diverse tenant mix, and proactive tenant relationship management. Its understanding of and flexibility towards tenant needs help extend lease terms and reduce vacancy rates. However, the inherent volatility of the retail sector and tenant business pressures mean customer retention is not absolutely secure."},"m10_durability":{"score":6,"comment_zh":"KIM 的商業模式具有一定的持久性，尤其是在其核心的必需消費品和服務租戶組合方面。然而，零售 REIT 面臨來自線上購物的長期結構性挑戰。KIM 通過專注於提供體驗式零售和必需品，以及將資產組合轉向更具韌性的業態，來應對這些挑戰，但其長期增長潛力仍受行業趨勢影響。","comment_en":"KIM's business model possesses a degree of durability, particularly with its core tenants in essential goods and services. However, retail REITs face long-term structural challenges from online shopping. KIM addresses these by focusing on experiential retail and necessities, and by shifting its portfolio towards more resilient formats. Nevertheless, its long-term growth potential remains influenced by industry trends."},"overall_moat_verdict_zh":"Kimco Realty (KIM) 作為一家大型零售 REIT，其護城河主要建立在獨特的地理位置資產（M6）和規模經濟帶來的成本優勢（M5）之上。其位於高增長地區的優質購物中心網絡，以及成熟的運營效率（M7），構成了其核心競爭力。儘管轉換成本（M3）和網絡效應（M4）提供了一定支持，但零售行業面臨的結構性挑戰，如電商競爭和消費者習慣變遷，限制了其品牌定價權（M1）和長期增長的可持續性。總體而言，KIM 類似於一個擁有良好地理位置的『收費橋樑』，其價值在於提供必需的零售空間，但其增長潛力受到行業趨勢的制約，而非典型的『特許經營』模式。","overall_moat_verdict_en":"Kimco Realty (KIM), a large retail REIT, derives its moat primarily from unique geographical assets (M6) and cost advantages from scale (M5). Its network of quality shopping centers in high-growth areas, coupled with strong operational efficiency (M7), forms its core competitive strength. While switching costs (M3) and network effects (M4) offer some support, structural challenges in retail, such as e-commerce competition and evolving consumer habits, limit its brand pricing power (M1) and long-term growth sustainability. Overall, KIM resembles a 'toll bridge' with prime locations, valued for providing essential retail space, but its growth potential is constrained by industry trends rather than a typical 'franchise' model.","evidenceHash":"39a3d097336782d099c350704e18bfed713f3b7126d1667db622f3f913b9494f","assessmentPolicy":"us-buffett-moat-v3"},"ratingSources":{"moat":{"reason":null},"fScore":{"score":6,"checkedAt":null},"zScore":{"asOfDate":"2025-12-31","period":"FY 2025","basis":"comparableAnnual","model":"z","zone":"distress","reason":null,"scoringCurrency":"USD","applicability":null,"checkedAt":"2026-10-27T16:12:46.364Z","evidenceHash":"e8a0ec810a4ba4990b25e5447161dc8f8fe0c603991550207754c090564e84c3"},"mScore":{"asOfDate":"2025-12-31","period":"FY 2025","basis":"comparableAnnual","model":null,"zone":"clean","reason":null,"scoringCurrency":"USD","applicability":null,"checkedAt":"2026-10-27T16:12:46.364Z","evidenceHash":"e8a0ec810a4ba4990b25e5447161dc8f8fe0c603991550207754c090564e84c3"}},"fin_valuation":{"is_financial":false},"image":"https://images.financialmodelingprep.com/symbol/KIM.png","logo":"https://images.financialmodelingprep.com/symbol/KIM.png","website":"https://www.kimcorealty.com","ceo":"Conor C. Flynn","full_time_employees":"710","description":"Kimco Realty Corporation (NYSE:KIM), headquartered in Jericho, N.Y., operates as a real estate investment trust (REIT). It stands as one of North America's preeminent publicly traded entities dedicated to the ownership and operation of open-air, grocery-anchored shopping centers and diverse mixed-use developments. With a substantial portfolio reported as of September 30, 2020, Kimco held interests in 400 properties across the U.S. These holdings collectively encompass 70 million square feet of gross leasable area, predominantly situated within America's top metropolitan markets. Having traded publicly on the New York Stock Exchange since 1991 and recognized as a constituent of the S&P 500 Index, the company boasts over six decades of expertise. This extensive experience spans the acquisition, development, and ongoing management of shopping centers.","description_en":"Kimco Realty Corporation (NYSE:KIM), headquartered in Jericho, N.Y., operates as a real estate investment trust (REIT). It stands as one of North America's preeminent publicly traded entities dedicated to the ownership and operation of open-air, grocery-anchored shopping centers and diverse mixed-use developments. With a substantial portfolio reported as of September 30, 2020, Kimco held interests in 400 properties across the U.S. These holdings collectively encompass 70 million square feet of gross leasable area, predominantly situated within America's top metropolitan markets. Having traded publicly on the New York Stock Exchange since 1991 and recognized as a constituent of the S&P 500 Index, the company boasts over six decades of expertise. This extensive experience spans the acquisition, development, and ongoing management of shopping centers.","description_zh":"**Kimco Realty Corporation (KIM) 業務營運精煉報告**\n\nKimco Realty Corporation (KIM) 是一家總部位於紐約州 Jericho 的房地產投資信託基金 (REIT)。公司專注於經營北美地區領先的露天式、以超市為主要錨定店的購物中心，以及多元化的混合用途開發案。截至 2020 年 9 月 30 日，Kimco 在全美擁有 400 處物業，總可出租面積達 7,000 萬平方英尺，主要集中在美國主要都會區。\n\nKimco 的核心業務模式為收購、開發及持續管理購物中心。其營運策略著重於擁有並經營具備穩定租金收入來源的超市錨定店，並透過多元化的租戶組合來提升物業價值。公司擁有超過六十年的產業經驗，自 1991 年起在紐約證券交易所掛牌交易，並為標準普爾 500 指數成分股。Kimco 的關鍵優勢在於其龐大的投資組合、優越的地理位置以及深厚的營運管理能力，使其在零售地產領域保持領先地位。","address":"500 North Broadway","city":"Jericho","state":"NY","zip":"11753-2128","country":"US","phone":"516-869-7235","full_address":"500 North Broadway, Jericho, NY 11753-2128, US","range_52w":"19.76-26.65","year_high":26.65,"year_low":19.76,"all_time_high":0,"all_time_low":19.76,"inst_ownership_pct":null,"insider_ownership_pct":null,"top_holders":[],"insider_trades":[{"date":"2026-04-03","name":"Thayer Kathleen","title":"officer: EVP, CAO and Treasurer","is_buy":null,"action":"","shares":0,"price":0,"total_val":0},{"date":"2026-02-20","name":"SALTZMAN RICHARD B","title":"director","is_buy":null,"action":"A-Award","shares":7720,"price":0,"total_val":0},{"date":"2026-02-20","name":"COVIELLO PHILIP E JR","title":"director","is_buy":null,"action":"A-Award","shares":7720,"price":0,"total_val":0},{"date":"2026-02-20","name":"Moniz Henry","title":"director","is_buy":null,"action":"A-Award","shares":7720,"price":0,"total_val":0},{"date":"2026-02-20","name":"Preusse Mary Hogan","title":"director","is_buy":null,"action":"A-Award","shares":7720,"price":0,"total_val":0},{"date":"2026-02-20","name":"Richardson Valerie","title":"director","is_buy":null,"action":"A-Award","shares":7720,"price":0,"total_val":0},{"date":"2026-02-20","name":"Lashine Nancy","title":"director","is_buy":null,"action":"A-Award","shares":7720,"price":0,"total_val":0},{"date":"2026-02-20","name":"LOURENSO FRANK","title":"director","is_buy":null,"action":"A-Award","shares":7720,"price":0,"total_val":0},{"date":"2026-02-20","name":"COHEN GLENN GARY","title":"officer: Exec VP, CFO","is_buy":null,"action":"A-Award","shares":31770,"price":0,"total_val":0},{"date":"2026-02-20","name":"Cooper Ross","title":"director, officer: President","is_buy":null,"action":"A-Award","shares":31770,"price":0,"total_val":0}],"stock_splits":[{"date":"2005-08-24","ratio":"2 : 1","desc":"供應商報告的股數調整比例；未獨立核實事件類型。","type":"FMP 股數調整"},{"date":"2001-12-24","ratio":"3 : 2","desc":"供應商報告的股數調整比例；未獨立核實事件類型。","type":"FMP 股數調整"},{"date":"1995-12-22","ratio":"3 : 2","desc":"供應商報告的股數調整比例；未獨立核實事件類型。","type":"FMP 股數調整"}],"fmp_symbol":"KIM","real_5y_prices":[],"historical_dcf_series":[],"name_en":"Kimco Realty Corpora